# Freqtrade + spoločné jadro `tradebot`.
#
# Build context je KOREŇ repozitára, nie tento adresár:
#   docker build -f docker/Dockerfile.freqtrade -t tradebot-freqtrade .
#
# Balík `tradebot` sa nedáva cez pip, ale cez PYTHONPATH. Vďaka tomu vie
# docker-compose primountovať zdrojáky read-only a zmeny v tradebot/ sa prejavia
# bez rebuildu - a zároveň image funguje aj samostatne bez mountu.

FROM freqtradeorg/freqtrade:stable

USER root

# Len zdrojaky jadra a metadata - ziadne user_data, ziadne stiahnute sviecky.
COPY --chown=ftuser:ftuser tradebot/ /app/tradebot/
COPY --chown=ftuser:ftuser pyproject.toml /app/pyproject.toml

USER ftuser

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1

# Sanity check uz pri buildovani - ked sa profily rozbiju, build spadne tu,
# nie az na serveri.
RUN python -c "from tradebot.core import load_profile; from tradebot.strategies import STRATEGIES; \
    [load_profile(f'{k}/{s.default_profile}') for k, s in STRATEGIES.items()]; \
    print('strategie:', sorted(STRATEGIES))"

WORKDIR /freqtrade
