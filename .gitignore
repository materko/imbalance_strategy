
*.pine.bak

ImbalanceStrategy.cs

ImbalanceStrategy_freqtrade.py

.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
deploy/freqtrade/user_data/logs/
deploy/freqtrade/user_data/backtest_results/
*.egg-info/
graf.html
*.html
# statická stránka webapp je zdroj, nie generovaný report
!tester/webapp/static/*.html
deploy/freqtrade/user_data/hyperopt_results/
# Natrenovane modely a cache predikcii FreqAI: generuje ich kazdy beh s --ai,
# su velke a z receptu (config + data) vzniknu znova.
deploy/freqtrade/user_data/models/
# Cele data/ je odvodene a do gitu nejde nikdy: data/tester/ sa zlozi z archivu
# (`python -m tester.data_archive merge`), chybajuce timeframy sa dopocitaju z 1m
# (`python -m tester.timeframes`, pripadne si ich poskladá strategia za behu) a
# data/quotemanager/ je z toho isteho dalsi export. Tester si cely strom pri prvom
# spusteni vyrobi sam.
# V gite je len data_archive/ - po rokoch a VYHRADNE to, co prislo z burzy alebo
# z raw exportu. Uzavrety rok sa uz nemeni, takze jeho blob v historii existuje raz;
# cely subor by pri kazdom stiahnuti pribudol znova.
data/
deploy/freqtrade/user_data/strategies/*.json
deploy/freqtrade/user_data/hyperopt.lock

# HTML reporty z `python -m tester.report` - generovane, nie zdroj
reports/

# webapp: docasne profily behov a konfiguracia Claude Code
tester/runs/.profiles/
# Plany hyperopt priestoru: docasne, patria k behu a nesu ich jeho settings.
tester/runs/.plans/
# Historia behov (tester/runs/) a vysledky mriezok, matic a overeni hyperoptu
# (tester/sweeps/) SU v gite - zdiela sa nimi praca testerov (`cli push`). Do gitu z nich
# nejdu len kresby grafu: mali ~1 MB na beh, historia ich mala tisice, repozitar narastol
# na 11 GB a GitHub push odmietol. Beh nesie cely config, takze graf sa prepocita, az ked
# ho niekto otvori (tester.webapp.replay), a ostane v lokalnej cache .charts/.
# Body mriezok a matic sa do runs/ neukladaju vobec (len riadok vysledku v sweeps/).
# Nic ine sa tu ignorovat nesmie: Push by to ticho vynechal - preto ho gitsync zastavi.
tester/runs/*/chart.json.gz
tester/runs/.charts/
# Index historie behov (sqlite) - odvodeny od run.json, postavi sa sam.
tester/runs/.index/
# Distribuovane pocitanie: stav hubu (agenti, fronta, odovzdane zipy) a konfiguracia
# agenta tohto klonu (adresa hubu, token) - oboje je per stroj, nie na zdielanie.
tester/hub_data/
tester/agent.json
tester/agent_state.json
.claude/

# Prelozene C# jadro - most si ho zostavi sam (python -m tradebot.adapters.csharp.build)
csharp/bin/

# rola pre Claude Code v tomto klone (tester | developer) - kazdy klon ma vlastnu
.tradebot-role
.ibs-role

# Synteticke trhy: velke a deterministicke - recept je v registri, data sa daju
# kedykolvek vygenerovat znova (`python -m tester.synthetic build`).
data/tester/synthetic/

# Vlastne upravy dockeru na tomto stroji: compose override (`-f zakladny -f moj`)
# a vlastny Dockerfile. Subory v docker/ bez `.local` a `.override` su spolocne
# a verzovane.
docker/*.local.yml
docker/*.override.yml
docker/Dockerfile.*.local
