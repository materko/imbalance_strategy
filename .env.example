# Skopiruj ako .env (do gitu sa necommituje).
TZ=Europe/Bratislava

# Pocet dni pre `docker compose run download`
DAYS=60

# Nazov strategie pre backtest / live (adapter je krok 4)
STRATEGY=IBSImbalanceStrategy

# Distribuovane pocitanie (docs/HUB.md).
# Hub (docker/docker-compose.hub.yml): hlavny (spravcovsky) token - povinny.
TRADEBOT_HUB_TOKEN=
# Kam sa port hubu naviaze na hostitelovi: 127.0.0.1 = za reverse proxy (odporucane).
TRADEBOT_HUB_BIND=127.0.0.1
TRADEBOT_HUB_PORT=8790
# Headless agent (docker/docker-compose.agent.yml): adresa hubu, token TOHTO agenta
# (`python -m tester.hub token add <meno>` na hube) a jeho staticke meno.
TRADEBOT_HUB_URL=
TRADEBOT_HUB_NAME=
TRADEBOT_HUB_MAX_PARALLEL=0

# API kluce burzy - NECHAJ PRAZDNE, kym nejdes obchodovat naostro.
# config.binance.json ma dry_run=true; zive obchodovanie je vedome prepnutie.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
