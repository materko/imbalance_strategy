//@version=5
// Demo Donchian Breakout — ukážková druhá stratégia TradeBotu.
//
// Zámerne malá: overuje rámec pre viac stratégií (registry, Freqtrade, MultiCharts,
// webapp), nie obchodný edge. Tento súbor je ZDROJ PRAVDY pre parametre portu
// (tradebot/strategies/demo_breakout/config.py): názvy, defaulty, rozsahy, titulky
// a tooltipy sa z neho parsujú do formulára webapp a stráži ich test parity.
strategy("Demo Donchian Breakout", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, process_orders_on_close=true)

// ---------------------------------------------------------------------------
// INPUTS
// ---------------------------------------------------------------------------
channelLen  = input.int(20, "Dlzka kanala (bary)", minval=5, maxval=200, tooltip="Kolko predchadzajucich barov tvori Donchian kanal. Close nad jeho hornou hranou = LONG breakout, pod dolnou = SHORT breakout. Aktualny bar sa do kanala nepocita.", group="🎯 Obchodovanie")
atrLen      = input.int(14, "ATR dlzka", minval=2, maxval=100, tooltip="Dlzka ATR (Wilder), z ktoreho sa pocita vzdialenost SL.", group="🎯 Obchodovanie")
slAtrMult   = input.float(1.5, "SL vzdialenost (nasobok ATR)", minval=0.1, maxval=10, step=0.1, tooltip="Stop loss = vstup -/+ tolkoto nasobkov ATR. Jednotka atr, aby to sedelo na kazdom nastroji.", group="🎯 Obchodovanie")
rrRatio     = input.float(2.0, "Risk:Reward pomer", minval=0.5, maxval=10, step=0.5, tooltip="Take profit = rrRatio × vzdialenost SL.", group="🎯 Obchodovanie")
allowShort  = input.bool(true, "Povolit short", tooltip="Vypnute = obchoduje sa len LONG breakout hornej hrany kanala.", group="🎯 Obchodovanie")
exitMode    = input.string("opposite", "Vystup", options=["opposite", "tp_only"], tooltip="opposite = otvorena pozicia sa zavrie aj pri opacnom breakoute (okrem SL/TP); tp_only = len SL alebo TP.", group="🎯 Obchodovanie")
riskDollar  = input.float(100, "Riziko na obchod ($)", minval=0, maxval=100000, step=10, tooltip="Velkost pozicie = riziko / vzdialenost SL. 0 = 1 kontrakt.", group="💰 Riziko")
showChannel = input.bool(true, "Kreslit kanal", tooltip="Zapne/vypne kreslenie hornej a dolnej hrany Donchian kanala.", group="🎨 Vizualizacia")

// ---------------------------------------------------------------------------
// LOGIKA
// ---------------------------------------------------------------------------
upper = ta.highest(high[1], channelLen)
lower = ta.lowest(low[1], channelLen)
atr   = ta.atr(atrLen)

plot(showChannel ? upper : na, "Kanal hore", color=color.new(color.blue, 30))
plot(showChannel ? lower : na, "Kanal dole", color=color.new(color.blue, 30))

longBreak  = close > upper and atr > 0
shortBreak = close < lower and atr > 0 and allowShort

slDist = slAtrMult * atr
qty    = riskDollar > 0 ? math.max(1, math.floor(riskDollar / slDist)) : 1

if longBreak and strategy.position_size <= 0
    if strategy.position_size < 0 and exitMode == "opposite"
        strategy.close("SHORT", immediately=true)
    if strategy.position_size == 0
        strategy.entry("LONG", strategy.long, qty=qty)
        strategy.exit("LONG-X", "LONG", stop=close - slDist, limit=close + rrRatio * slDist)
        label.new(bar_index, low, "LONG", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white)

if shortBreak and strategy.position_size >= 0
    if strategy.position_size > 0 and exitMode == "opposite"
        strategy.close("LONG", immediately=true)
    if strategy.position_size == 0
        strategy.entry("SHORT", strategy.short, qty=qty)
        strategy.exit("SHORT-X", "SHORT", stop=close + slDist, limit=close - rrRatio * slDist)
        label.new(bar_index, high, "SHORT", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)
