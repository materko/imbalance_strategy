//@version=5
strategy("Imbalance strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=true, pyramiding=10, process_orders_on_close=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==================== INPUTS ====================
entryTF       = input.string("2", "Entry timeframe (minutes) len na kreslenie", options=["1","2","3","5"], group="⚙️ Základné nastavenia")
weekdaysOnly  = input.bool(true, "Trade only Mon-Fri", group="⚙️ Základné nastavenia")

// ==================== SESSION 1 ====================
sess1On        = input.bool(true, "Zapnúť", group="📗 Session 1", inline="s1on")
sess1TZ        = input.string("America/New_York", "Timezone", group="📗 Session 1", inline="s1on")
sess1ZoneStartH = input.int(10, "SD zóna začiatok (H)", group="📗 Session 1", inline="s1z")
sess1ZoneStartM = input.int(30, "M", group="📗 Session 1", inline="s1z")
sess1ZoneEndH   = input.int(11, "SD zóna koniec (H)", group="📗 Session 1", inline="s1ze")
sess1ZoneEndM   = input.int(30, "M", group="📗 Session 1", inline="s1ze")
sess1TradeStartH = input.int(11, "Trade začiatok (H)", group="📗 Session 1", inline="s1t")
sess1TradeStartM = input.int(0, "M", group="📗 Session 1", inline="s1t")
sess1TradeEndH   = input.int(12, "Trade koniec (H)", group="📗 Session 1", inline="s1te")
sess1TradeEndM   = input.int(0, "M", group="📗 Session 1", inline="s1te")

// ==================== SESSION 2 ====================
sess2On        = input.bool(true, "Zapnúť", group="📘 Session 2", inline="s2on")
sess2TZ        = input.string("America/New_York", "Timezone", group="📘 Session 2", inline="s2on")
sess2ZoneStartH = input.int(12, "SD zóna začiatok (H)", group="📘 Session 2", inline="s2z")
sess2ZoneStartM = input.int(0, "M", group="📘 Session 2", inline="s2z")
sess2ZoneEndH   = input.int(13, "SD zóna koniec (H)", group="📘 Session 2", inline="s2ze")
sess2ZoneEndM   = input.int(0, "M", group="📘 Session 2", inline="s2ze")
sess2TradeStartH = input.int(12, "Trade začiatok (H)", group="📘 Session 2", inline="s2t")
sess2TradeStartM = input.int(30, "M", group="📘 Session 2", inline="s2t")
sess2TradeEndH   = input.int(13, "Trade koniec (H)", group="📘 Session 2", inline="s2te")
sess2TradeEndM   = input.int(30, "M", group="📘 Session 2", inline="s2te")

// ==================== SESSION 3 ====================
sess3On        = input.bool(true, "Zapnúť", group="📙 Session 3", inline="s3on")
sess3TZ        = input.string("Europe/London", "Timezone", group="📙 Session 3", inline="s3on")
sess3ZoneStartH = input.int(8, "SD zóna začiatok (H)", group="📙 Session 3", inline="s3z")
sess3ZoneStartM = input.int(0, "M", group="📙 Session 3", inline="s3z")
sess3ZoneEndH   = input.int(11, "SD zóna koniec (H)", group="📙 Session 3", inline="s3ze")
sess3ZoneEndM   = input.int(0, "M", group="📙 Session 3", inline="s3ze")
sess3TradeStartH = input.int(8, "Trade začiatok (H)", group="📙 Session 3", inline="s3t")
sess3TradeStartM = input.int(30, "M", group="📙 Session 3", inline="s3t")
sess3TradeEndH   = input.int(11, "Trade koniec (H)", group="📙 Session 3", inline="s3te")
sess3TradeEndM   = input.int(0, "M", group="📙 Session 3", inline="s3te")

zoneValidHours    = input.int(26, "Platnosť zóny (hodiny)", minval=1, maxval=72, group="📦 SD Zóny")
maxSdZones        = input.int(200, "Max SD zón", minval=10, maxval=999, group="📦 SD Zóny")
snapMode          = input.string("Floor", "Snap času zóny na TF grid", options=["Off","Floor","Ceil","Round"], group="📦 SD Zóny")
invalidateOnFill  = input.bool(true, "Invaliduj zónu pri vyplnení orderu (STATE 5)", tooltip="Ak je zaškrtnuté, SD zóna sa vizuálne uzavrie keď sa order vyplní. Ak nie, zóna zostane otvorená.", group="📦 SD Zóny")
closeAtSessionEnd = input.bool(true, "Zatvor všetky pozície na konci session", tooltip="Na konci každej trade session sa zatvoria všetky otvorené pozície a zrušia pending ordery", group="⚙️ Základné nastavenia")

showImbalance  = input.bool(false, "Zobraz imbalance sviečky", tooltip="Vyznačí FVG/imbalance sviečky dutým telom na aktuálnom TF", group="🎨 Vizualizácia")
showOrderLabel = input.bool(true,  "Zobraz label E/SL/TP pri orderi", tooltip="Žltý label s Entry, SL a TP cenami pri STATE 4", group="🎨 Vizualizácia")

imbLookback     = input.int(5, "Max barov dozadu pre IMB", minval=1, maxval=50, tooltip="Koľko barov dozadu hľadať imbalance sviečku pri SD zóne", group="🔄 State machine")
imbMaxDistTicks = input.int(70, "Max vzdialenosť IMB od zóny (ticky)", minval=0, maxval=500, tooltip="Maximálna medzera medzi IMB sviečkou a hranou SD zóny", group="🔄 State machine")
state1MaxBars   = input.int(5, "STATE 1: Max barov na exit zo zóny", minval=1, maxval=50, tooltip="Koľko barov má cena na to aby vyšla zo zóny na strane IMB", group="🔄 State machine")
state2MaxBars   = input.int(15, "STATE 2: Max barov", minval=1, maxval=50, tooltip="Koľko barov trvá STATE 2, ak sa presiahne → invalidácia", group="🔄 State machine")
state3MaxBars   = input.int(5, "STATE 3: Max barov", minval=1, maxval=50, tooltip="Koľko barov trvá STATE 3, ak sa presiahne → invalidácia", group="🔄 State machine")
state4MaxBars   = input.int(5, "STATE 4: Max barov", minval=1, maxval=50, tooltip="Koľko barov trvá STATE 4, ak sa presiahne → invalidácia", group="🔄 State machine")
state5MaxBars   = input.int(5, "STATE 5: Max barov na fill", minval=1, maxval=50, tooltip="Koľko barov čaká pending order na vyplnenie, ak sa presiahne → zrušenie", group="🔄 State machine")
rrRatio         = input.float(1.3, "Risk:Reward pomer", minval=0.5, maxval=10.0, step=0.5, tooltip="Pomer TP ku SL vzdialenosti (napr. 1.0 = 1:1, 2.0 = 1:2)", group="🔄 State machine")
slType          = input.string("Swing", "SL typ", options=["Swing", "Fixný $"], tooltip="Swing = SL na swing low/high. Fixný $ = SL podľa max straty v dolároch.", group="🔄 State machine")
slLookback      = input.int(10, "SL: lookback barov od aktuálnej sviečky", minval=1, maxval=100, tooltip="Koľko barov dozadu od aktuálnej sviečky (STATE 4) hľadáme najnižší low (LONG) / najvyšší high (SHORT) pre umiestnenie SL", group="🔄 State machine")
slBufferTicks   = input.int(2, "SL: buffer (ticky)", minval=0, maxval=50, tooltip="Počet tickov pod najnižším lowom / nad najvyšším highom pre SL", group="🔄 State machine")
slFixedDollar   = input.float(50, "SL: max strata ($)", minval=1, maxval=1000, step=1, tooltip="Maximálna strata v dolároch na jeden trade (len pre Fixný $ typ)", group="🔄 State machine")
slScaleOn       = input.bool(false, "SL scaling po strate", tooltip="Po stratovom trade sa Fixný $ SL zvýši násobkom. Po výhre sa resetne na základ.", group="📈 SL Scaling")
slScale1        = input.float(2.0, "1. strata → násobok", minval=1.0, maxval=20.0, step=0.1, tooltip="Po 1. strate: SL = základ × tento násobok", group="📈 SL Scaling")
slScale2        = input.float(4.0, "2. strata → násobok", minval=1.0, maxval=20.0, step=0.1, tooltip="Po 2. po sebe idúcej strate: SL = základ × tento násobok", group="📈 SL Scaling")
slScale3        = input.float(8.0, "3. strata → násobok", minval=1.0, maxval=20.0, step=0.1, tooltip="Po 3. po sebe idúcej strate: SL = základ × tento násobok", group="📈 SL Scaling")
slScale4        = input.float(16.0, "4. strata → násobok (max)", minval=1.0, maxval=20.0, step=0.1, tooltip="Po 4.+ po sebe idúcej strate: SL = základ × tento násobok (maximum)", group="📈 SL Scaling")
maxDailyWins    = input.int(2, "Max ziskových tradov za deň", minval=1, maxval=20, tooltip="Po dosiahnutí tohto počtu ziskových tradov v daný deň sa prestane obchodovať do konca dňa", group="🔄 State machine")

// ==================== CONSTS ====================
plot(close, title="__scale_anchor__", color=color.new(color.white, 100))
int stepMs       = int(str.tonumber(entryTF) * 60000)
int zoneValidMs  = int(zoneValidHours * 3600000)
int maxSdZonesEff = math.min(maxSdZones, 200)

// ==================== GRID SNAP ====================
snapTime(int t) =>
    int out = t
    out := (snapMode == "Off" or stepMs <= 0) ? t : (snapMode == "Floor" ? int(math.floor((t / stepMs)) * stepMs) : (snapMode == "Ceil" ? int(math.ceil((t / stepMs)) * stepMs) : int(math.round((t / stepMs)) * stepMs)))
    out

// ==================== HELPERS ====================
isBull(float o, float c) => c > o
isBear(float o, float c) => c < o


inWindowTZ(int sh, int sm, int eh, int em, string tz) =>
    int y  = year(time, tz)
    int mo = month(time, tz)
    int d  = dayofmonth(time, tz)
    int st = timestamp(tz, y, mo, d, sh, sm)
    int en = timestamp(tz, y, mo, d, eh, em)
    int en2 = en <= st ? en + 86400000 : en
    int t2  = time < st ? time + 86400000 : time
    t2 >= st and t2 < en2

// Per-session weekday filter — kontroluje víkend v TZ samotnej session
isWeekdayTZ(string tz) =>
    int sdow = dayofweek(time, tz)
    not weekdaysOnly or (sdow >= dayofweek.monday and sdow <= dayofweek.friday)

// Má session ešte START "dnes" (v jej TZ)? = jej trade window ešte len začne
sessionStartInFutureToday(bool enabled, int sh, int sm, string tz) =>
    bool result = false
    if enabled and isWeekdayTZ(tz)
        int startT = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), sh, sm)
        result := time < startT
    result

// Session 1 okná — s per-tz weekend filtrom
bool s1Zone  = sess1On and isWeekdayTZ(sess1TZ) and inWindowTZ(sess1ZoneStartH, sess1ZoneStartM, sess1ZoneEndH, sess1ZoneEndM, sess1TZ)
bool s1Trade = sess1On and isWeekdayTZ(sess1TZ) and inWindowTZ(sess1TradeStartH, sess1TradeStartM, sess1TradeEndH, sess1TradeEndM, sess1TZ)
// Session 2 okná
bool s2Zone  = sess2On and isWeekdayTZ(sess2TZ) and inWindowTZ(sess2ZoneStartH, sess2ZoneStartM, sess2ZoneEndH, sess2ZoneEndM, sess2TZ)
bool s2Trade = sess2On and isWeekdayTZ(sess2TZ) and inWindowTZ(sess2TradeStartH, sess2TradeStartM, sess2TradeEndH, sess2TradeEndM, sess2TZ)
// Session 3 okná
bool s3Zone  = sess3On and isWeekdayTZ(sess3TZ) and inWindowTZ(sess3ZoneStartH, sess3ZoneStartM, sess3ZoneEndH, sess3ZoneEndM, sess3TZ)
bool s3Trade = sess3On and isWeekdayTZ(sess3TZ) and inWindowTZ(sess3TradeStartH, sess3TradeStartM, sess3TradeEndH, sess3TradeEndM, sess3TZ)

// Kombinované okná (per-tz weekend filter je už v každej sNZone/sNTrade)
bool inZoneWindow  = s1Zone or s2Zone or s3Zone
bool inTradeWindow = s1Trade or s2Trade or s3Trade
bool tradeWindowJustClosed = inTradeWindow[1] and not inTradeWindow  // prechod z ON → OFF

// Last session of the day = trade window sa práve zatvoril a žiadna ďalšia session
// už dnes vo svojej TZ nezačne (porovnáva v UTC ms cez timestamp())
bool s1FutureStart = sessionStartInFutureToday(sess1On, sess1TradeStartH, sess1TradeStartM, sess1TZ)
bool s2FutureStart = sessionStartInFutureToday(sess2On, sess2TradeStartH, sess2TradeStartM, sess2TZ)
bool s3FutureStart = sessionStartInFutureToday(sess3On, sess3TradeStartH, sess3TradeStartM, sess3TZ)
bool noMoreSessionsToday = not s1FutureStart and not s2FutureStart and not s3FutureStart
bool lastSessionJustClosed = tradeWindowJustClosed and noMoreSessionsToday

// ==================== BACKGROUND ====================
bgcolor(s1Trade ? color.new(color.blue, 90) : (s1Zone ? color.new(color.blue, 95) : na), title="Session 1")
bgcolor(s2Trade ? color.new(color.teal, 90) : (s2Zone ? color.new(color.teal, 95) : na), title="Session 2")
bgcolor(s3Trade ? color.new(color.purple, 90) : (s3Zone ? color.new(color.purple, 95) : na), title="Session 3")

// ==================== MANUÁLNE 5-MIN BARY (bez request.security) ====================
// Buildujeme 5-min OHLC z 2-min dát → funguje identicky na backtest, replay aj live
int t5m = time("5")
bool new5mBar = ta.change(t5m) != 0

// Aktuálny (neuzavretý) 5-min bar
var float cur5m_o = na
var float cur5m_h = na
var float cur5m_l = na
var float cur5m_c = na
var int   cur5m_t = na

if new5mBar
    cur5m_o := open
    cur5m_h := high
    cur5m_l := low
    cur5m_t := t5m
else
    cur5m_h := math.max(nz(cur5m_h, high), high)
    cur5m_l := math.min(nz(cur5m_l, low), low)
cur5m_c := close

// História posledných 5 potvrdených 5-min barov (index 0 = najnovší potvrdený)
var float[] h5m_o = array.from(float(na), float(na), float(na), float(na), float(na))
var float[] h5m_c = array.from(float(na), float(na), float(na), float(na), float(na))
var float[] h5m_h = array.from(float(na), float(na), float(na), float(na), float(na))
var float[] h5m_l = array.from(float(na), float(na), float(na), float(na), float(na))
var int[]   h5m_t = array.from(int(na), int(na), int(na), int(na), int(na))

if new5mBar
    // Predchádzajúci 5-min bar sa práve uzavrel → vlož do histórie
    // Použi [1] hodnoty pretože nový bar práve začal
    array.pop(h5m_o)
    array.unshift(h5m_o, nz(cur5m_o[1], open[1]))
    array.pop(h5m_c)
    array.unshift(h5m_c, close[1])
    array.pop(h5m_h)
    array.unshift(h5m_h, nz(cur5m_h[1], high[1]))
    array.pop(h5m_l)
    array.unshift(h5m_l, nz(cur5m_l[1], low[1]))
    array.pop(h5m_t)
    array.unshift(h5m_t, nz(cur5m_t[1], int(na)))

// Potvrdené 5-min bary: [0]=posledný uzavretý, [1]=predposledný, ...
float o5_0 = array.get(h5m_o, 0)
float c5_0 = array.get(h5m_c, 0)
float h5_0 = array.get(h5m_h, 0)
float l5_0 = array.get(h5m_l, 0)
int   t5_0 = array.get(h5m_t, 0)

float o5_1 = array.get(h5m_o, 1)
float c5_1 = array.get(h5m_c, 1)
float h5_1 = array.get(h5m_h, 1)
float l5_1 = array.get(h5m_l, 1)

float o5_2 = array.get(h5m_o, 2)
float c5_2 = array.get(h5m_c, 2)
float h5_2 = array.get(h5m_h, 2)
float l5_2 = array.get(h5m_l, 2)

float o5_3 = array.get(h5m_o, 3)
float c5_3 = array.get(h5m_c, 3)
float h5_3 = array.get(h5m_h, 3)
float l5_3 = array.get(h5m_l, 3)
int   t5_3 = array.get(h5m_t, 3)

// ==================== DETEKCIA SD ZÓNY NA 5M ====================
// Pattern na potvrdených 5-min baroch: [3]=signálna, [2],[1],[0]=reversal
// LONG:  [3]=bear, potom reversal (3 bull ALEBO imbalance)
// SHORT: [3]=bull, potom reversal (3 bear ALEBO imbalance)
bool bull5m_0 = c5_0 > o5_0
bool bear5m_0 = c5_0 < o5_0
bool bull5m_1 = c5_1 > o5_1
bool bear5m_1 = c5_1 < o5_1
bool bull5m_2 = c5_2 > o5_2
bool bear5m_2 = c5_2 < o5_2
bool bull5m_3 = c5_3 > o5_3
bool bear5m_3 = c5_3 < o5_3

// Imbalance (FVG) na 5-min baroch
bool bullImb5_1 = not na(h5_2) and l5_0 > h5_2    // gap medzi bar0 a bar2
bool bearImb5_1 = not na(l5_2)  and h5_0 < l5_2
bool bullImb5_2 = not na(h5_3) and l5_1 > h5_3    // gap medzi bar1 a bar3
bool bearImb5_2 = not na(l5_3)  and h5_1 < l5_3

// Pattern varianty
bool longV1  = bear5m_3 and bull5m_2 and bull5m_1 and bull5m_0
bool longV2  = bear5m_3 and bull5m_2 and bullImb5_1
bool longV3  = bear5m_3 and bull5m_2 and bullImb5_2
bool shortV1 = bull5m_3 and bear5m_2 and bear5m_1 and bear5m_0
bool shortV2 = bull5m_3 and bear5m_2 and bearImb5_1
bool shortV3 = bull5m_3 and bear5m_2 and bearImb5_2

// Detekuj len keď nový 5-min bar práve uzavrel (nie na každom 2-min bare)
bool patternDetected = new5mBar and inZoneWindow

// Výsledok detekcie
int   zTyp5  = patternDetected and (longV1 or longV2 or longV3) ? 1 : (patternDetected and (shortV1 or shortV2 or shortV3) ? -1 : 0)
float zTop5  = zTyp5 != 0 ? h5_3 : na
float zBot5  = zTyp5 != 0 ? l5_3 : na
int   zT05   = zTyp5 != 0 ? t5_3 : na
int   zTConf5 = zTyp5 != 0 ? t5_0 : na

// ==================== ZONE ARRAYS ====================
var float[] zTopA  = array.new_float()
var float[] zBotA  = array.new_float()
var int[]   zTypA  = array.new_int()
var int[]   zExpA  = array.new_int()
var bool[]  zUsedA = array.new_bool()
var int[]   zStateA = array.new_int()        // 0=čakám na IMB, 1=IMB nájdená, ...
var int[]   zColorIdxA = array.new_int()     // index farby z poolu (0-9), na = nepriradená
var float[] zImbBodyTopA = array.new_float() // IMB sviečka: vrch tela
var float[] zImbBodyBotA = array.new_float() // IMB sviečka: spodok tela
var float[] zImbOpenA = array.new_float()    // IMB sviečka: open (entry price)
var float[] zImbHiA  = array.new_float()     // IMB sviečka: high
var float[] zImbLoA  = array.new_float()     // IMB sviečka: low
var int[]   zImbBiA  = array.new_int()       // IMB sviečka: bar_index strednej sviečky
var box[]   zImbBoxA = array.new_box()       // box okolo IMB sviečky
var bool[]  zTouchedA = array.new_bool()     // true = cena už bola v zóne (invaliduje STATE 0)
var int[]   zStateBiA = array.new_int()      // bar_index kedy sa vstúpilo do aktuálneho stavu
var box[]   zPreBoxA  = array.new_box()
var box[]   zPostBoxA = array.new_box()
var line[]  zEntryLineA = array.new_line()  // entry čiara
var line[]  zSlLineA    = array.new_line()  // SL čiara
var line[]  zTpLineA    = array.new_line()  // TP čiara
var bool[]  zImb0LblDrawnA = array.new_bool()  // či bol label "0" na IMB sviecke nakreslený
var bool[]  zFilledA = array.new_bool()        // true = order bol vyplnený (pozícia bola otvorená)
var bool[]  zPendingInvalidA = array.new_bool() // true = cena prešla zónou počas STATE 1-4 → odložená vizuálna invalidácia

var label[] stateLabelPool = array.new_label()  // rolling buffer pre state labels
int stateLabelMax = 500

// ==================== DAILY WIN LIMIT ====================
var int dailyWinsCount = 0   // počet ziskových tradov dnes
var int lastDayKey     = na  // identifikátor dňa (YYYYMMDD) pre reset
var int consecLosses   = 0   // počet po sebe idúcich strát (pre SL scaling)
var bool scaledEntryUsed = false  // true = škálovaný entry bol umiestnený, ďalšie pyramidované entry dostanú základ

// Farebný pool — 10 kontrastných farieb
var color[] colorPool = array.from(color.rgb(255,0,255), color.rgb(0,255,255), color.rgb(255,140,0), color.rgb(50,205,50), color.rgb(255,20,147), color.rgb(30,144,255), color.rgb(255,215,0), color.rgb(138,43,226), color.rgb(255,69,0), color.rgb(0,255,127))

// ==================== DRAW SD ZONES ====================
var int lastDrawT0 = na

newZone = zTyp5 != 0 and not na(zT05) and not na(zTop5) and not na(zBot5) and (na(lastDrawT0) or zT05 != lastDrawT0)

if newZone
    int leftT = snapTime(zT05)
    int expT  = leftT + zoneValidMs
    int confT = not na(zTConf5) ? snapTime(zTConf5) : snapTime(time)
    confT := confT < leftT ? leftT : confT
    confT := confT > expT  ? expT  : confT

    color col  = zTyp5 == 1 ? color.new(color.red, 85) : color.new(color.blue, 85)
    color bord = zTyp5 == 1 ? color.red : color.blue

    // Pre-confirmation box (dotted)
    int preR = confT > leftT ? confT : leftT + stepMs
    preR := preR > expT ? expT : preR
    box preB = box.new(leftT, zTop5, preR, zBot5, xloc=xloc.bar_time, bgcolor=na, border_color=bord, border_style=line.style_dotted)

    // Post-confirmation box (solid, filled)
    int postL = confT
    int postR = expT > postL ? expT : postL + stepMs
    box postB = box.new(postL, zTop5, postR, zBot5, xloc=xloc.bar_time, bgcolor=col, border_color=bord, border_style=line.style_solid)

    array.push(zPreBoxA, preB)
    array.push(zPostBoxA, postB)
    array.push(zTopA, zTop5)
    array.push(zBotA, zBot5)
    array.push(zTypA, zTyp5)
    array.push(zExpA, expT)
    array.push(zUsedA, false)
    array.push(zStateA, 0)
    array.push(zColorIdxA, na)
    array.push(zImbBodyTopA, na)
    array.push(zImbBodyBotA, na)
    array.push(zImbOpenA, na)
    array.push(zImbHiA, na)
    array.push(zImbLoA, na)
    array.push(zImbBiA, na)
    array.push(zImbBoxA, na)
    array.push(zTouchedA, false)
    array.push(zStateBiA, na)
    array.push(zEntryLineA, line(na))
    array.push(zSlLineA, line(na))
    array.push(zTpLineA, line(na))
    array.push(zImb0LblDrawnA, false)
    array.push(zFilledA, false)
    array.push(zPendingInvalidA, false)

    // Cleanup ak prekročíme limit
    if array.size(zTopA) > maxSdZonesEff
        box oldPre = array.shift(zPreBoxA)
        box oldPost = array.shift(zPostBoxA)
        if not na(oldPre)
            box.delete(oldPre)
        if not na(oldPost)
            box.delete(oldPost)
        box oldImb = array.shift(zImbBoxA)
        if not na(oldImb)
            box.delete(oldImb)
        line oldEntry = array.shift(zEntryLineA)
        if not na(oldEntry)
            line.delete(oldEntry)
        line oldSl = array.shift(zSlLineA)
        if not na(oldSl)
            line.delete(oldSl)
        line oldTp = array.shift(zTpLineA)
        if not na(oldTp)
            line.delete(oldTp)
        array.shift(zTopA)
        array.shift(zBotA)
        array.shift(zTypA)
        array.shift(zExpA)
        array.shift(zUsedA)
        array.shift(zStateA)
        array.shift(zColorIdxA)
        array.shift(zImbBodyTopA)
        array.shift(zImbBodyBotA)
        array.shift(zImbOpenA)
        array.shift(zImbHiA)
        array.shift(zImbLoA)
        array.shift(zImbBiA)
        array.shift(zTouchedA)
        array.shift(zStateBiA)
        array.shift(zImb0LblDrawnA)
        array.shift(zFilledA)
        array.shift(zPendingInvalidA)

    lastDrawT0 := zT05

// ==================== EXPIRÁCIA ZÓN ====================
int zN = array.size(zTopA)
if zN > 0
    for i = 0 to zN - 1
        if not array.get(zUsedA, i) and time >= array.get(zExpA, i)
            array.set(zUsedA, i, true)

// ==================== IMBALANCE SVIEČKY (DUTÉ) ====================
// FVG pattern: gap medzi bar[0] a bar[2], stredná sviečka bar[1] = imbalance
// Bull IMB: low > high[2]  (gap nahor)
// Bear IMB: high < low[2]  (gap nadol)
bool bullIMB = low > high[2] and close[1] > high[2]
bool bearIMB = high < low[2] and close[1] < low[2]
bool isImbCandle = bullIMB or bearIMB

// Detekcia sa robí na aktuálnom bare, ale IMB sviečka je bar[1]
// Použijeme barcolor na bar[1] (offset=-1) na vizuálne odlíšenie
// + nakreslíme box okolo tela sviečky s priehľadným vnútrom (duté telo)
color imbBarCol = showImbalance and isImbCandle ? (bullIMB ? color.new(color.green, 90) : color.new(color.red, 90)) : na
barcolor(imbBarCol, offset=-1, title="IMB candle fade")

// Duté telo = box s border farbou, bez výplne
var box[] imbBoxPool = array.new_box()
int imbBoxMax = 200
if showImbalance and isImbCandle
    float bTop = math.max(open[1], close[1])
    float bBot = math.min(open[1], close[1])
    // Ak je doji (open==close), daj minimálnu výšku
    float adjTop = bTop == bBot ? bTop + syminfo.mintick * 0.5 : bTop
    float adjBot = bTop == bBot ? bBot - syminfo.mintick * 0.5 : bBot
    color bCol = bullIMB ? color.green : color.red
    box b = box.new(bar_index - 1, adjTop, bar_index - 1, adjBot, bgcolor=color.new(color.white, 100), border_color=bCol, border_width=2, border_style=line.style_solid)
    array.push(imbBoxPool, b)
    if array.size(imbBoxPool) > imbBoxMax
        box old = array.shift(imbBoxPool)
        box.delete(old)

// ==================== STATE MACHINE ====================
// STATE 0: cena sa dotýka SD zóny → hľadáme IMB sviečku v lookback-u
//          Ak cena odíde zo zóny bez nájdenia IMB → invalidácia
// STATE 1: IMB nájdená, cena v zóne, čakáme na exit na strane IMB (max N barov)
//          LONG: close > top, SHORT: close < bot → STATE 2, SD zóna invalidovaná (pyramiding)
// STATE 2: čakáme kým cena prekoná open IMB sviecky (max N barov)
//          LONG: close > imbBodyTop, SHORT: close < imbBodyBot → STATE 3
// STATE 3: cena prekonala open IMB, čakáme na návrat späť (max N barov)
//          LONG: close < imbBodyTop, SHORT: close > imbBodyBot → STATE 4
// STATE 4: limit order na open IMB sviecky, SL na swing low/high, TP podľa RR (max N barov)
//
// Pre LONG (demand) zónu: hľadáme BEAR IMB nad/pri zóne (cena klesá k zóne)
// Pre SHORT (supply) zónu: hľadáme BULL IMB pod/pri zóne (cena stúpa k zóne)

float imbMaxDist = imbMaxDistTicks * syminfo.mintick

// Orezanie zóny pri invalidácii
resizeZoneOnInvalidation(int zoneIdx) =>
    box preBox = array.get(zPreBoxA, zoneIdx)
    box postBox = array.get(zPostBoxA, zoneIdx)
    if not na(preBox)
        box.set_right(preBox, time)
    if not na(postBox)
        box.set_right(postBox, time)

// Zmazanie trade boxov pri invalidácii/ukončení
deleteTradeLines(int zoneIdx) =>
    line el = array.get(zEntryLineA, zoneIdx)
    if not na(el)
        line.delete(el)
        array.set(zEntryLineA, zoneIdx, line(na))
    line sl = array.get(zSlLineA, zoneIdx)
    if not na(sl)
        line.delete(sl)
        array.set(zSlLineA, zoneIdx, line(na))
    line tp = array.get(zTpLineA, zoneIdx)
    if not na(tp)
        line.delete(tp)
        array.set(zTpLineA, zoneIdx, line(na))

// Sekvenčný index farby — rotuje cez pool
var int nextColorIdx = 0

// Reset denného počítadla ziskov na začiatku nového dňa
int todayKey = year(time, "UTC") * 10000 + month(time, "UTC") * 100 + dayofmonth(time, "UTC")
if na(lastDayKey) or todayKey != lastDayKey
    dailyWinsCount := 0
    lastDayKey := todayKey

bool dailyWinLimitReached = dailyWinsCount >= maxDailyWins

// SL scaling sa počíta priamo v STATE 4 (effectiveMultiplier) — prvý entry po stratách dostane škálovaný SL

// Počítadlo labelov na aktuálnom bare (pre vertikálny offset pri viacerých state machines)
int lblCountUp = 0    // LONG labely (pod sviečkou)
int lblCountDown = 0  // SHORT labely (nad sviečkou)

if zN > 0
    for i = 0 to zN - 1
        bool used = array.get(zUsedA, i)
        int st = array.get(zStateA, i)
        // Aktívne zóny (state 0,1) ALEBO used zóny s pokračujúcim state machine (state >= 2)
        bool active = (not used and st >= 0) or (used and st >= 2 and st <= 5)
        if active
            int typ = array.get(zTypA, i)
            float top = array.get(zTopA, i)
            float bot = array.get(zBotA, i)
            bool inZoneNow = high >= bot and low <= top

// ===== STATE 0: čakáme na dotyk ceny so zónou, potom hľadáme IMB =====
            if st == 0
                bool wasTouched = array.get(zTouchedA, i)

                // Označ prístup zo správnej strany
                if not wasTouched
                    bool correctApproach = (typ == 1 and low <= top and high >= top) or (typ == -1 and high >= bot and low <= bot)
                    if correctApproach
                        array.set(zTouchedA, i, true)
                        wasTouched := true

                if wasTouched
                    // NAJPRV hľadáme IMB — ak sa nájde, zóna prežije aj keď cena prešla cez ňu
                    float bestDist = na
                    int bestLb = na

                    for lb = 0 to imbLookback - 1
                        if bar_index >= lb + 2
                            bool isBullImb = low[lb] > high[lb + 2] and close[lb + 1] > high[lb + 2]
                            bool isBearImb = high[lb] < low[lb + 2] and close[lb + 1] < low[lb + 2]
                            int midIdx = lb + 1

                            // LONG zóna: bear IMB nad/pri vrchu zóny, alebo prechádza celou zónou
                            if typ == 1 and isBearImb
                                bool imbAbove   = open[midIdx] > top
                                bool imbThrough = high[midIdx] >= top and low[midIdx] <= bot
                                if imbAbove or imbThrough
                                    float gap = low[midIdx] - top
                                    float dist = math.max(0.0, gap)
                                    if dist <= imbMaxDist
                                        if na(bestDist) or dist < bestDist
                                            bestDist := dist
                                            bestLb := lb

                            // SHORT zóna: bull IMB pod/pri spodku zóny, alebo prechádza celou zónou
                            if typ == -1 and isBullImb
                                bool imbBelow   = open[midIdx] < bot
                                bool imbThrough = high[midIdx] >= top and low[midIdx] <= bot
                                if imbBelow or imbThrough
                                    float gap = bot - high[midIdx]
                                    float dist = math.max(0.0, gap)
                                    if dist <= imbMaxDist
                                        if na(bestDist) or dist < bestDist
                                            bestDist := dist
                                            bestLb := lb

                    // Ak sme našli IMB → STATE 1 (aj keď cena prešla cez zónu)
                    if not na(bestLb)
                        int midIdx = bestLb + 1
                        float bTop = math.max(open[midIdx], close[midIdx])
                        float bBot = math.min(open[midIdx], close[midIdx])

                        // Ulož IMB dáta
                        array.set(zImbBodyTopA, i, bTop)
                        array.set(zImbBodyBotA, i, bBot)
                        array.set(zImbOpenA, i, open[midIdx])
                        array.set(zImbHiA, i, high[midIdx])
                        array.set(zImbLoA, i, low[midIdx])
                        array.set(zImbBiA, i, bar_index - midIdx)

                        // Priraď farbu (rotácia cez pool)
                        int cIdx = nextColorIdx
                        nextColorIdx := (nextColorIdx + 1) % array.size(colorPool)
                        array.set(zColorIdxA, i, cIdx)
                        color zCol = array.get(colorPool, cIdx)

                        // Nakresli box okolo IMB sviečky
                        float adjTop = bTop == bBot ? bTop + syminfo.mintick * 0.5 : bTop
                        float adjBot = bTop == bBot ? bBot - syminfo.mintick * 0.5 : bBot
                        box imbBox = box.new(bar_index - midIdx, adjTop, bar_index - midIdx, adjBot, bgcolor=color.new(zCol, 80), border_color=zCol, border_width=2)
                        array.set(zImbBoxA, i, imbBox)

                        // Zmeň border SD zóny na rovnakú farbu
                        box preBox = array.get(zPreBoxA, i)
                        box postBox = array.get(zPostBoxA, i)
                        if not na(preBox)
                            box.set_border_color(preBox, zCol)
                        if not na(postBox)
                            box.set_border_color(postBox, zCol)
                            box.set_bgcolor(postBox, color.new(zCol, 85))

                        // Prechod do STATE 1 (label "0" sa nakreslí v label sekcii nižšie)
                        array.set(zStateA, i, 1)
                        array.set(zStateBiA, i, bar_index)
                        st := 1
                    else
                        // IMB sa nenašla → invalidácia len keď cena PREŠLA CELOU zónou:
                        bool invalidated = (typ == 1 and low < bot) or (typ == -1 and high > top)
                        if invalidated
                            resizeZoneOnInvalidation(i)
                            array.set(zUsedA, i, true)
                            array.set(zStateA, i, -1)

            // ===== RE-ENTRY: STATE 1-4, cena znova vstúpi zo správnej strany + nová IMB =====
            if st >= 1 and st <= 4
                // Cena musí DOSIAHNUŤ zónu (pretínať hranu), nie len byť na správnej strane
                bool reEntry = (typ == 1 and low <= top and high >= top) or (typ == -1 and high >= bot and low <= bot)
                if reEntry
                    float reBestDist = na
                    int   reBestLb   = na
                    for lb = 0 to imbLookback - 1
                        if bar_index >= lb + 2
                            bool reBullImb = low[lb] > high[lb + 2] and close[lb + 1] > high[lb + 2]
                            bool reBearImb = high[lb] < low[lb + 2] and close[lb + 1] < low[lb + 2]
                            int  reMid     = lb + 1
                            if typ == 1 and reBearImb
                                bool imbAbove   = open[reMid] > top
                                bool imbThrough = high[reMid] >= top and low[reMid] <= bot
                                if imbAbove or imbThrough
                                    float dist = math.max(0.0, low[reMid] - top)
                                    if dist <= imbMaxDist and (na(reBestDist) or dist < reBestDist)
                                        reBestDist := dist
                                        reBestLb   := lb
                            if typ == -1 and reBullImb
                                bool imbBelow   = open[reMid] < bot
                                bool imbThrough = high[reMid] >= top and low[reMid] <= bot
                                if imbBelow or imbThrough
                                    float dist = math.max(0.0, bot - high[reMid])
                                    if dist <= imbMaxDist and (na(reBestDist) or dist < reBestDist)
                                        reBestDist := dist
                                        reBestLb   := lb

                    // Nová IMB je iná ako aktuálna → reset state machine
                    if not na(reBestLb)
                        int newImbBi = bar_index - (reBestLb + 1)
                        bool isDifferentImb = newImbBi != array.get(zImbBiA, i)
                        if isDifferentImb
                            // Zruš pending ordery
                            strategy.cancel("LONG_"  + str.tostring(i))
                            strategy.cancel("SHORT_" + str.tostring(i))
                            // Ulož novú IMB
                            int   reMid2 = reBestLb + 1
                            float bTop2  = math.max(open[reMid2], close[reMid2])
                            float bBot2  = math.min(open[reMid2], close[reMid2])
                            array.set(zImbBodyTopA, i, bTop2)
                            array.set(zImbBodyBotA, i, bBot2)
                            array.set(zImbOpenA,    i, open[reMid2])
                            array.set(zImbHiA,      i, high[reMid2])
                            array.set(zImbLoA,      i, low[reMid2])
                            array.set(zImbBiA,      i, newImbBi)
                            // Nakresli nový IMB box
                            box oldImb2 = array.get(zImbBoxA, i)
                            if not na(oldImb2)
                                box.delete(oldImb2)
                            int   cIdxRe = array.get(zColorIdxA, i)
                            color zColRe = na(cIdxRe) ? color.white : array.get(colorPool, cIdxRe)
                            float aTop2  = bTop2 == bBot2 ? bTop2 + syminfo.mintick * 0.5 : bTop2
                            float aBot2  = bTop2 == bBot2 ? bBot2 - syminfo.mintick * 0.5 : bBot2
                            box newImb2  = box.new(newImbBi, aTop2, newImbBi, aBot2, bgcolor=color.new(zColRe, 80), border_color=zColRe, border_width=2)
                            array.set(zImbBoxA, i, newImb2)
                            // Reset flagov a stavu → STATE 1
                            array.set(zFilledA,        i, false)
                            array.set(zPendingInvalidA, i, false)
                            array.set(zImb0LblDrawnA,   i, false)
                            array.set(zUsedA,           i, false)  // potrebné pre active check v STATE 1
                            array.set(zStateA,          i, 1)
                            array.set(zStateBiA,        i, bar_index)
                            st := 1

            // Detekcia priechodu zónou počas STATE 1-5
            // STATE 1-4: odložená invalidácia (čaká na koniec state machine)
            // STATE 5: ak je pozícia vyplnená → okamžitá vizuálna invalidácia
            if st >= 1 and st <= 5
                bool passedThrough = (typ == 1 and high >= top and low < bot) or (typ == -1 and low <= bot and high > top)
                if passedThrough and not array.get(zPendingInvalidA, i)
                    array.set(zPendingInvalidA, i, true)
                    if st == 5 and array.get(zFilledA, i)
                        resizeZoneOnInvalidation(i)

            // ===== STATE 1: cena v zóne, čakáme na exit na strane IMB =====
            if st == 1
                int stateBi = array.get(zStateBiA, i)
                stateBi := na(stateBi) ? bar_index : stateBi
                int barsInState = bar_index - stateBi
                int cIdx1 = array.get(zColorIdxA, i)
                color zCol1 = na(cIdx1) ? color.white : array.get(colorPool, cIdx1)

                if barsInState > state1MaxBars
                    // Timeout → invalidácia
                    resizeZoneOnInvalidation(i)
                    array.set(zUsedA, i, true)
                    array.set(zStateA, i, -1)
                else
                    // LONG: čakáme na exit NAD zónou — bar musí pretínať hornú hranu (nie len byť nad)
                    if typ == 1 and high > top and low <= top
                        array.set(zStateA, i, 2)
                        array.set(zStateBiA, i, bar_index)
                        array.set(zUsedA, i, true)
                        st := 2

                    // SHORT: čakáme na exit POD zónou — bar musí pretínať dolnú hranu (nie len byť pod)
                    if typ == -1 and low < bot and high >= bot
                        array.set(zStateA, i, 2)
                        array.set(zStateBiA, i, bar_index)
                        array.set(zUsedA, i, true)
                        st := 2

            // ===== STATE 2: čakáme kým cena prekoná open IMB sviecky =====
            if st == 2
                int stateBi = array.get(zStateBiA, i)
                stateBi := na(stateBi) ? bar_index : stateBi
                int barsInState = bar_index - stateBi
                int cIdx2 = array.get(zColorIdxA, i)
                color zCol2 = na(cIdx2) ? color.white : array.get(colorPool, cIdx2)

                if barsInState > state2MaxBars
                    // Timeout → invalidácia
                    resizeZoneOnInvalidation(i)
                    array.set(zStateA, i, -1)
                else
                    float imbBodyTop = array.get(zImbBodyTopA, i)
                    float imbBodyBot = array.get(zImbBodyBotA, i)

                    // LONG: sviečka UZAVRIE nad vrchom tela IMB sviečky
                    if typ == 1 and close > imbBodyTop
                        array.set(zStateA, i, 3)
                        array.set(zStateBiA, i, bar_index)
                        st := 3

                    // SHORT: sviečka UZAVRIE pod spodkom tela IMB sviečky
                    if typ == -1 and close < imbBodyBot
                        array.set(zStateA, i, 3)
                        array.set(zStateBiA, i, bar_index)
                        st := 3

            // ===== STATE 3: cena prekonala open IMB, čakáme na návrat späť =====
            if st == 3
                int stateBi = array.get(zStateBiA, i)
                stateBi := na(stateBi) ? bar_index : stateBi
                int barsInState = bar_index - stateBi
                int cIdx3 = array.get(zColorIdxA, i)
                color zCol3 = na(cIdx3) ? color.white : array.get(colorPool, cIdx3)

                if barsInState > state3MaxBars
                    // Timeout → invalidácia
                    resizeZoneOnInvalidation(i)
                    array.set(zStateA, i, -1)
                else
                    float imbOpen = array.get(zImbOpenA, i)

                    // LONG: cena sa vráti na open IMB sviecky
                    if typ == 1 and low <= imbOpen
                        array.set(zStateA, i, 4)
                        array.set(zStateBiA, i, bar_index)
                        st := 4

                    // SHORT: cena sa vráti na open IMB sviecky
                    if typ == -1 and high >= imbOpen
                        array.set(zStateA, i, 4)
                        array.set(zStateBiA, i, bar_index)
                        st := 4

            // ===== STATE 4: umiestni limit order + nakresli box =====
            if st == 4
                // Denný limit ziskových tradov — neobchodujeme ak bol dosiahnutý
                if dailyWinLimitReached
                    resizeZoneOnInvalidation(i)
                    array.set(zStateA, i, -1)
                    st := -1
                    // Label na graf: trade preskočený kvôli max daily trades
                    float yMax = typ == 1 ? low - syminfo.mintick * 30 : high + syminfo.mintick * 30
                    label maxLbl = label.new(bar_index, yMax, "MAX\nDAILY", xloc=xloc.bar_index, style=typ == 1 ? label.style_label_up : label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)
                    array.push(stateLabelPool, maxLbl)
                    if array.size(stateLabelPool) > stateLabelMax
                        label oldMax = array.shift(stateLabelPool)
                        label.delete(oldMax)

            if st == 4
                // Mimo trade okna → neobchodujeme + zruš prípadnú pending limitku
                if not inTradeWindow
                    string cancelId4 = (typ == 1 ? "LONG_" : "SHORT_") + str.tostring(i)
                    strategy.cancel(cancelId4)
                    deleteTradeLines(i)
                    resizeZoneOnInvalidation(i)
                    array.set(zStateA, i, -1)
                    st := -1

            if st == 4
                float imbOpen4 = array.get(zImbOpenA, i)
                int cIdx4 = array.get(zColorIdxA, i)
                color zCol4 = na(cIdx4) ? color.white : array.get(colorPool, cIdx4)

                // Entry na open IMB sviecky
                float entryPrice = imbOpen4
                float slPrice = na
                float tpPrice = na
                int lineEnd = bar_index + state5MaxBars

                // Výpočet effective multiplier pre SL scaling (na úrovni STATE 4)
                float effectiveMultiplier = 1.0
                if slScaleOn and slType == "Fixný $" and not scaledEntryUsed and consecLosses > 0
                    if consecLosses == 1
                        effectiveMultiplier := slScale1
                    else if consecLosses == 2
                        effectiveMultiplier := slScale2
                    else if consecLosses == 3
                        effectiveMultiplier := slScale3
                    else if consecLosses >= 4
                        effectiveMultiplier := slScale4

                if slType == "Swing"
                    // SWING SL: nearest lower low (LONG) / higher high (SHORT) od aktuálnej sviečky
                    float slSwing = na
                    for lb = 0 to slLookback - 1
                        if bar_index >= lb
                            if typ == 1
                                if na(slSwing) or low[lb] < slSwing
                                    slSwing := low[lb]
                            else
                                if na(slSwing) or high[lb] > slSwing
                                    slSwing := high[lb]
                    float slBuf = slBufferTicks * syminfo.mintick
                    if typ == 1
                        slPrice := (na(slSwing) ? bot : slSwing) - slBuf
                    else
                        slPrice := (na(slSwing) ? top : slSwing) + slBuf
                else
                    // FIXNÝ $ SL: SL vzdialenosť = (maxStrata$ × multiplier) / pointvalue
                    float scaledSL = slFixedDollar * effectiveMultiplier
                    float slDist = scaledSL / syminfo.pointvalue
                    if typ == 1
                        slPrice := entryPrice - slDist
                    else
                        slPrice := entryPrice + slDist

                // TP podľa RR pomeru + ochrana proti zatvoreniu opačnej pozície
                bool oppositeOpen = (typ == 1 and strategy.position_size < 0) or (typ == -1 and strategy.position_size > 0)

                if typ == 1 and not oppositeOpen
                    float slDist = entryPrice - slPrice
                    tpPrice := entryPrice + slDist * rrRatio
                    strategy.entry("LONG_" + str.tostring(i), strategy.long, limit=entryPrice)
                    strategy.exit("TP_SL_LONG_" + str.tostring(i), "LONG_" + str.tostring(i), stop=slPrice, limit=tpPrice)
                    if effectiveMultiplier > 1.0
                        scaledEntryUsed := true

                if typ == -1 and not oppositeOpen
                    float slDist = slPrice - entryPrice
                    tpPrice := entryPrice - slDist * rrRatio
                    strategy.entry("SHORT_" + str.tostring(i), strategy.short, limit=entryPrice)
                    strategy.exit("TP_SL_SHORT_" + str.tostring(i), "SHORT_" + str.tostring(i), stop=slPrice, limit=tpPrice)
                    if effectiveMultiplier > 1.0
                        scaledEntryUsed := true

                // Kreslenie čiar (entry, SL, TP)
                if not na(slPrice) and not na(tpPrice)
                    line eLine = line.new(bar_index, entryPrice, lineEnd, entryPrice, color=zCol4, width=2)
                    line sLine = line.new(bar_index, slPrice, lineEnd, slPrice, color=color.red, width=2)
                    line tLine = line.new(bar_index, tpPrice, lineEnd, tpPrice, color=color.green, width=2)
                    array.set(zEntryLineA, i, eLine)
                    array.set(zSlLineA, i, sLine)
                    array.set(zTpLineA, i, tLine)

                // DEBUG: label na potvrdenie STATE 4 + hodnoty
                if showOrderLabel
                    string dbgTxt = "S4\nE:" + str.tostring(entryPrice, "#.##") + "\nSL:" + str.tostring(slPrice, "#.##") + "\nTP:" + str.tostring(tpPrice, "#.##") + "\ni:" + str.tostring(i)
                    label dbgLbl = label.new(bar_index, typ == 1 ? low - syminfo.mintick * 30 : high + syminfo.mintick * 30, dbgTxt, xloc=xloc.bar_index, style=typ == 1 ? label.style_label_up : label.style_label_down, color=color.yellow, textcolor=color.black, size=size.small)
                    array.push(stateLabelPool, dbgLbl)

                // Okamžite → STATE 5 (order umiestnený, čaká na fill/timeout)
                array.set(zStateA, i, 5)
                array.set(zStateBiA, i, bar_index)
                st := 5

            // ===== STATE 5: order umiestnený, čaká na fill alebo timeout =====
            if st == 5
                // Ak trade okno skončilo a order nebol vyplnený → okamžitý cancel
                // (na historických dátach sa pending order inak vyplní skôr ako session end blok)
                bool wasFilled5 = array.get(zFilledA, i)
                if not inTradeWindow and not wasFilled5
                    string cancelId5 = (typ == 1 ? "LONG_" : "SHORT_") + str.tostring(i)
                    strategy.cancel(cancelId5)
                    deleteTradeLines(i)
                    array.set(zStateA, i, -1)
                    st := -1

            if st == 5
                int stateBi5 = array.get(zStateBiA, i)
                stateBi5 := na(stateBi5) ? bar_index : stateBi5
                int barsInState5 = bar_index - stateBi5
                bool wasFilled = array.get(zFilledA, i)

                // Per-zóna detekcia fillu cez strategy.opentrades.entry_id()
                string myOrderId = (typ == 1 ? "LONG_" : "SHORT_") + str.tostring(i)
                bool myOrderOpen = false
                for t = 0 to strategy.opentrades - 1
                    if strategy.opentrades.entry_id(t) == myOrderId
                        myOrderOpen := true

                // Ak sa TENTO order práve otvoril, označ ako filled
                if myOrderOpen and not wasFilled
                    array.set(zFilledA, i, true)
                    wasFilled := true
                    if invalidateOnFill or array.get(zPendingInvalidA, i)
                        resizeZoneOnInvalidation(i)

                line elive = array.get(zEntryLineA, i)
                line slive = array.get(zSlLineA, i)
                line tlive = array.get(zTpLineA, i)

                // Skontroluj či cena dosiahla TP alebo SL → zastaviť predlžovanie
                bool levelHit = false
                bool tpHit = false
                bool slHit = false
                if not na(slive) and not na(tlive)
                    float slLevel = line.get_y1(slive)
                    float tpLevel = line.get_y1(tlive)
                    tpHit := typ == 1 ? high >= tpLevel : low <= tpLevel
                    slHit := typ == 1 ? low <= slLevel : high >= slLevel
                    levelHit := tpHit or slHit

                // Pozícia bola vyplnená a teraz je zatvorená (už nie je v opentrades)
                bool positionClosed = wasFilled and not myOrderOpen

                if levelHit or positionClosed
                    // Počítaj ziskové/stratové trady (aj pri levelHit aj positionClosed)
                    if wasFilled
                        if positionClosed
                            // Najspoľahlivejšie — použijeme skutočný profit z closedtrades
                            int nClosed = strategy.closedtrades
                            if nClosed > 0
                                float lastProfit = strategy.closedtrades.profit(nClosed - 1)
                                if lastProfit > 0
                                    dailyWinsCount += 1
                                    consecLosses := 0
                                    scaledEntryUsed := false
                                else if lastProfit < 0
                                    consecLosses := math.min(consecLosses + 1, 4)
                                    scaledEntryUsed := false
                        else if levelHit
                            // Fallback — pozícia ešte nie je zatvorená v stratégii,
                            // ale cena dosiahla TP/SL úroveň → určíme podľa toho čo bolo zasiahnuté
                            if tpHit
                                dailyWinsCount += 1
                                consecLosses := 0
                                scaledEntryUsed := false
                            else if slHit
                                consecLosses := math.min(consecLosses + 1, 4)
                                scaledEntryUsed := false
                    // Čiary zastavia presne tu, zostanú ako historický záznam
                    if invalidateOnFill or array.get(zPendingInvalidA, i)
                        resizeZoneOnInvalidation(i)
                    array.set(zStateA, i, -1)
                else
                    // Predlžuj SL/TP/Entry čiary každý bar
                    if not na(elive)
                        line.set_x2(elive, bar_index + 1)
                    if not na(slive)
                        line.set_x2(slive, bar_index + 1)
                    if not na(tlive)
                        line.set_x2(tlive, bar_index + 1)

                // Timeout: cancel pending order + zmaž čiary LEN ak order NEBOL nikdy vyplnený
                if barsInState5 > state5MaxBars and not myOrderOpen and not wasFilled
                    strategy.cancel(myOrderId)
                    deleteTradeLines(i)
                    array.set(zStateA, i, -1)
                    // Label: order expiroval bez vyplnenia
                    float yExp = typ == 1 ? low - syminfo.mintick * 30 : high + syminfo.mintick * 30
                    label expLbl = label.new(bar_index, yExp, "EXPIRED", xloc=xloc.bar_index, style=typ == 1 ? label.style_label_up : label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)
                    array.push(stateLabelPool, expLbl)
                    if array.size(stateLabelPool) > stateLabelMax
                        label oldExp = array.shift(stateLabelPool)
                        label.delete(oldExp)

            // ===== STATE LABELS: label s číslom stavu na každom bare od state 1+ =====
            if st >= 1 and st <= 4 and barstate.isconfirmed
                int cIdxL = array.get(zColorIdxA, i)
                color lblCol = na(cIdxL) ? color.white : array.get(colorPool, cIdxL)

                // Label "0" na IMB sviecke — nakreslí sa raz (pri prvom confirmed bare v state >= 1)
                bool lbl0Drawn = array.get(zImb0LblDrawnA, i)
                if not lbl0Drawn
                    int imbBi = array.get(zImbBiA, i)
                    if not na(imbBi)
                        int imbOffset = bar_index - imbBi
                        float imbY = typ == 1 ? low[imbOffset] - syminfo.mintick * 5 : high[imbOffset] + syminfo.mintick * 5
                        label lbl0 = label.new(imbBi, imbY, "0", xloc=xloc.bar_index, style=typ == 1 ? label.style_label_up : label.style_label_down, color=lblCol, textcolor=color.white, size=size.tiny)
                        array.push(stateLabelPool, lbl0)
                        if array.size(stateLabelPool) > stateLabelMax
                            label oldL0 = array.shift(stateLabelPool)
                            label.delete(oldL0)
                        array.set(zImb0LblDrawnA, i, true)

                // Label s aktuálnym stavom na tomto bare
                float tickOff = syminfo.mintick * 10
                float yPos = na
                if typ == 1
                    yPos := low - tickOff * (1 + lblCountUp)
                    lblCountUp += 1
                else
                    yPos := high + tickOff * (1 + lblCountDown)
                    lblCountDown += 1
                string lblText = str.tostring(st)
                if st == 4
                    float dbgImbOpen = array.get(zImbOpenA, i)
                    lblText := "4\n" + str.tostring(dbgImbOpen)
                label lbl = label.new(bar_index, yPos, lblText, style=typ == 1 ? label.style_label_up : label.style_label_down, color=lblCol, textcolor=color.white, size=size.tiny)
                array.push(stateLabelPool, lbl)
                if array.size(stateLabelPool) > stateLabelMax
                    label old = array.shift(stateLabelPool)
                    label.delete(old)

// ==================== CLOSE AT SESSION END ====================
// Zatvor všetky pozície a pending ordery keď posledná session dňa skončila
// (žiadna ďalšia session už dnes vo svojej TZ nezačne)
if closeAtSessionEnd and lastSessionJustClosed
    int nZones = array.size(zStateA)
    for i = 0 to nZones - 1
        int zSt = array.get(zStateA, i)
        if zSt >= 1 and zSt <= 5
            int zTypSess = array.get(zTypA, i)
            string sessOrderId = (zTypSess == 1 ? "LONG_" : "SHORT_") + str.tostring(i)
            // Vždy zruš pending limit order (mohol byť umiestnený v STATE 4)
            strategy.cancel(sessOrderId)
            if zSt == 5
                // Zatvor otvorenú pozíciu pre túto zónu
                bool myOpen = false
                for t = 0 to strategy.opentrades - 1
                    if strategy.opentrades.entry_id(t) == sessOrderId
                        myOpen := true
                if myOpen
                    strategy.close(sessOrderId, comment="SESSION_END")
            // Zmaž čiary ak boli nakreslené a order nebol vyplnený
            if zSt >= 4 and not array.get(zFilledA, i)
                deleteTradeLines(i)
            array.set(zStateA, i, -1)