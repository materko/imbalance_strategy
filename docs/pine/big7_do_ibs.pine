// ═══════════════════════════════════════════════════════════════════════════
// BIG 7 — filter smeru pre IBS Imbalance Breakout Strategy (Pine v6)
//
// Vlož CELÝ tento blok do svojej IBS stratégie tesne PRED riadok:
//     // ==================== CONSTS ====================
// V tom mieste sú už všetky inputy hotové a blok je sebestačný — nič z neho
// nekoliduje s existujúcimi menami (všetko je prefixované `b7`).
//
// Potom sprav tri drobné úpravy v STATE 4 — sú popísané v big7_do_ibs.md.
//
// POZOR na rozdiel oproti samostatnému indikátoru: IBS beží s `overlay=true`,
// takže sa skóre NEDÁ vykresliť do vlastného panelu pod grafom (Pine nevie
// poslať plot do iného panelu, `force_overlay` funguje len opačným smerom).
// Tu dostaneš číslo, stav, tabuľku a samotný filter — čiaru si nechaj
// zobrazenú z indikátora vedľa, počíta to isté.
// ═══════════════════════════════════════════════════════════════════════════

_GB7 = "🧠 Big 7 (smer Nasdaqu)"

useBig7Filter = input.bool(false, "Big 7: filter smeru obchodov", group=_GB7,
     tooltip="Vypnuté = stratégia sa správa presne ako doteraz. Zapnuté = LONG zóny sa " +
     "obchodujú len keď je Nasdaq kôš nad nulou, SHORT len keď je pod ňou. Vlastný " +
     "'Trade direction' ostáva nadradený — z 'Long only' Big 7 shorty nespraví.")
b7Mode        = input.string("Nula", "Pravidlo", options=["Nula", "Prah", "Stav LONG/SELL"],
     group=_GB7, tooltip="Nula = stačí, aby skóre bolo na správnej strane nuly (najmenej " +
     "prísne). Prah = skóre musí prekročiť ±Prah skóre. Stav = musí byť potvrdený signál " +
     "so šírkou aj súhlasom SOXX (najprísnejšie, najmenej obchodov).")
b7OutRth      = input.string("Prepustiť", "Mimo burzových hodín", options=["Prepustiť", "Blokovať"],
     group=_GB7, tooltip="Big 7 má dáta len 9:30–16:00 New York. Prepustiť = mimo toho filter " +
     "nerobí nič a IBS obchoduje ako doteraz. Blokovať = mimo burzových hodín sa neobchoduje vôbec.")
b7Th          = input.int(40, "Prah skóre", minval=5, maxval=100, group=_GB7)
b7MinBreadth  = input.int(5, "Min. titulov na strane signálu", minval=1, maxval=7, group=_GB7)
b7NeedSoxx    = input.bool(true, "SOXX musí súhlasiť", group=_GB7)
b7Confirm     = input.int(2, "Potvrdiť N sviečok", minval=1, maxval=20, group=_GB7)
b7SkipOpen    = input.int(3, "Preskočiť prvých N sviečok dňa", minval=0, maxval=60, group=_GB7)
b7ClearMode   = input.string("Oboje", "Stav vynulovať",
     options=["Pri prechode cez nulu", "Na začiatku dňa", "Oboje", "Nikdy"], group=_GB7,
     tooltip="Bez tohto by stav držal starý smer, kým sa nepotvrdí opačný — a keby sa opačný " +
     "nepotvrdil, blokoval by jeden smer celé hodiny. Vynulovaný stav = bez smeru.")

b7Anchor      = input.string("Včerajšie zavretie", "Percentá počítať od",
     options=["Včerajšie zavretie", "Denné otvorenie"], group=_GB7,
     tooltip="Pre vnútrodenné obchodovanie dáva zmysel skôr 'Denné otvorenie' — nočná medzera " +
     "je v momente otvorenia už zaplatená a merať dnešný ťah má zmysel od otvorenia.")
b7EmaLen      = input.int(9,    "Dĺžka EMA koša", minval=2, maxval=200, group=_GB7)
b7Smooth      = input.int(3,    "Vyhladiť skóre (EMA)", minval=1, maxval=50, group=_GB7)
b7NormPct     = input.float(1.0,  "Kôš / SOXX: plné skóre pri (%)", minval=0.05, step=0.05, group=_GB7)
b7NormSlope   = input.float(0.05, "Trend: plné skóre pri sklone", minval=0.005, step=0.005, group=_GB7,
     tooltip="Závisí od timeframu grafu. Na 15m nechaj 0,05; na 5m daj ~0,025; na 1m ~0,005.")
b7NormLead    = input.float(0.5,  "Vedenie: plné skóre pri rozdiele (%)", minval=0.05, step=0.05, group=_GB7)

b7wBasket  = input.float(1.0, "Váha: Kôš",     minval=0.0, step=0.1, group=_GB7)
b7wTrend   = input.float(1.0, "Váha: Trend",   minval=0.0, step=0.1, group=_GB7)
b7wBreadth = input.float(1.0, "Váha: Šírka",   minval=0.0, step=0.1, group=_GB7)
b7wSoxx    = input.float(1.0, "Váha: SOXX",    minval=0.0, step=0.1, group=_GB7)
b7wLead    = input.float(0.5, "Váha: Vedenie", minval=0.0, step=0.1, group=_GB7)

b7s1 = input.symbol("NASDAQ:NVDA",  "Titul 1", group=_GB7)
b7s2 = input.symbol("NASDAQ:MSFT",  "Titul 2", group=_GB7)
b7s3 = input.symbol("NASDAQ:AAPL",  "Titul 3", group=_GB7)
b7s4 = input.symbol("NASDAQ:AMZN",  "Titul 4", group=_GB7)
b7s5 = input.symbol("NASDAQ:GOOGL", "Titul 5", group=_GB7)
b7s6 = input.symbol("NASDAQ:META",  "Titul 6", group=_GB7)
b7s7 = input.symbol("NASDAQ:TSLA",  "Titul 7", group=_GB7)
b7SoxxSym = input.symbol("NASDAQ:SOXX", "Polovodiče", group=_GB7)
b7IdxSym  = input.symbol("NASDAQ:QQQ",  "Index na porovnanie", group=_GB7)

b7ShowTable = input.bool(true, "Big 7: tabuľka", group=_GB7)
b7TablePos  = input.string("Bottom Left", "Big 7: pozícia tabuľky",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=_GB7)
b7ShowBg    = input.bool(false, "Big 7: podfarbiť pozadie podľa smeru", group=_GB7,
     tooltip="Pozor, IBS už pozadím kreslí seansy — ak si to zapneš, farby sa budú miešať.")

// ---- farby (vlastné, nezávislé od PAL_* palety stratégie) ---- //
b7Palette = input.string("Neón", "Big 7: paleta", options=["Neón", "Klasika"], group=_GB7,
     tooltip="Neón = cyan / magenta, na čiernom pozadí svieti. Klasika = zelená / červená.")

color B7_UP   = b7Palette == "Neón" ? #00e5ff : #00e676
color B7_DN   = b7Palette == "Neón" ? #ff2e7e : #ff1744
color B7_FLAT = #90a4ae

// ---- percentuálna zmena jedného symbolu od denného ukotvenia ---- //
// Obe ukotvenia naraz jedným dotazom — 9 symbolov × 2 volania = 18, spolu s tromi
// dotazmi, ktoré už stratégia má, je to 21 zo 40 povolených.
f_b7pct(simple string sym) =>
    [dOpen, dPrevClose] = request.security(sym, "D", [open, close[1]],
         barmerge.gaps_off, barmerge.lookahead_off)
    px = request.security(sym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
    anchor = b7Anchor == "Denné otvorenie" ? dOpen : dPrevClose
    na(px) or na(anchor) or anchor == 0 ? float(na) : (px - anchor) / anchor * 100.0

//: EMA, ktorá sa vie resetovať. Každé volanie má vlastný stav (`var` vo funkcii).
f_b7ema(float src, simple int len, bool doReset) =>
    var float e = na
    a = 2.0 / (len + 1)
    if not na(src)
        e := na(e) or doReset ? src : e + a * (src - e)
    e

f_b7clamp(float v) => na(v) ? float(na) : math.max(-1.0, math.min(1.0, v))

b7p1 = f_b7pct(b7s1)
b7p2 = f_b7pct(b7s2)
b7p3 = f_b7pct(b7s3)
b7p4 = f_b7pct(b7s4)
b7p5 = f_b7pct(b7s5)
b7p6 = f_b7pct(b7s6)
b7p7 = f_b7pct(b7s7)
b7SoxxPct = f_b7pct(b7SoxxSym)
b7IdxPct  = f_b7pct(b7IdxSym)

// Rovnako vážený priemer — chýbajúci titul vypadne AJ Z MENOVATEĽA, nepočíta sa
// ako nula. Inak by mlčiaci feed ťahal celý kôš k nule.
b7pcts = array.from(b7p1, b7p2, b7p3, b7p4, b7p5, b7p6, b7p7)
float b7Sum = 0.0
int   b7Ok  = 0
int   b7Up  = 0
for b7i = 0 to 6
    float pv = array.get(b7pcts, b7i)
    if not na(pv)
        b7Sum += pv
        b7Ok  += 1
        if pv > 0
            b7Up += 1
int   b7Down    = b7Ok - b7Up
float b7Basket  = b7Ok > 0 ? b7Sum / b7Ok : float(na)

// ---- EMA koša s denným resetom ---- //
// Percentá sú ukotvené ku dňu, takže séria každé ráno skočí späť k nule.
// Priebežná EMA by do dnešného otvorenia ťahala včerajšie hodnoty.
bool b7NewDay = ta.change(time("D")) != 0
var int b7BarsToday = 0
b7BarsToday := b7NewDay ? 1 : b7BarsToday + 1
bool b7Reset = b7NewDay

float b7Ema   = f_b7ema(b7Basket, b7EmaLen, b7Reset)
float b7Slope = b7Reset or na(b7Ema) or na(b7Ema[1]) ? 0.0 : b7Ema - b7Ema[1]

// ---- päť zložiek skóre, každá −1…+1 ---- //
float b7cBasket  = f_b7clamp(b7Basket / b7NormPct)
float b7cTrend   = na(b7Ema) ? float(na) : f_b7clamp(b7Slope / b7NormSlope)
float b7cBreadth = b7Ok > 0 ? (b7Up - b7Down) / b7Ok : float(na)
float b7cSoxx    = f_b7clamp(b7SoxxPct / b7NormPct)
float b7cLead    = na(b7Basket) or na(b7IdxPct) ? float(na) : f_b7clamp((b7Basket - b7IdxPct) / b7NormLead)

b7parts   = array.from(b7cBasket, b7cTrend, b7cBreadth, b7cSoxx, b7cLead)
b7weights = array.from(b7wBasket, b7wTrend, b7wBreadth, b7wSoxx, b7wLead)
float b7sSum = 0.0
float b7sW   = 0.0
for b7i = 0 to 4
    float cv = array.get(b7parts, b7i)
    float wv = array.get(b7weights, b7i)
    if not na(cv) and wv > 0
        b7sSum += cv * wv
        b7sW   += wv
float b7ScoreRaw = b7sW > 0 ? b7sSum / b7sW * 100.0 : float(na)
// Vyhladenie sa volá vždy, aj keď je vypnuté — funkcia so stavom sa v Pine nesmie
// volať podmienene, inak jej stav zamrzne na baroch, kde sa nezavolá.
float b7ScoreSm = f_b7ema(b7ScoreRaw, b7Smooth, b7Reset)
float b7Score   = b7Smooth > 1 ? b7ScoreSm : b7ScoreRaw

// ---- stav LONG / SELL ---- //
bool b7InRth = not na(time(timeframe.period, "0930-1600", "America/New_York"))
bool b7Ready = not na(b7Score) and b7BarsToday > b7SkipOpen and b7Ok > 0 and b7InRth

bool b7SoxxLongOk  = not b7NeedSoxx or (not na(b7SoxxPct) and b7SoxxPct > 0)
bool b7SoxxShortOk = not b7NeedSoxx or (not na(b7SoxxPct) and b7SoxxPct < 0)

bool b7LongOk  = b7Ready and b7Score >=  b7Th and b7Up   >= b7MinBreadth and b7SoxxLongOk
bool b7ShortOk = b7Ready and b7Score <= -b7Th and b7Down >= b7MinBreadth and b7SoxxShortOk

var int b7LongRun  = 0
var int b7ShortRun = 0
b7LongRun  := b7LongOk  ? b7LongRun  + 1 : 0
b7ShortRun := b7ShortOk ? b7ShortRun + 1 : 0

bool b7ClearZero = b7ClearMode == "Pri prechode cez nulu" or b7ClearMode == "Oboje"
bool b7ClearDay  = b7ClearMode == "Na začiatku dňa" or b7ClearMode == "Oboje"

var int b7State = 0
int b7Next = b7State
if b7LongRun >= b7Confirm
    b7Next := 1
else if b7ShortRun >= b7Confirm
    b7Next := -1
else if b7ClearZero and not na(b7Score) and ((b7State == 1 and b7Score < 0) or (b7State == -1 and b7Score > 0))
    b7Next := 0
if b7ClearDay and b7NewDay
    b7Next := 0
if barstate.isconfirmed
    b7State := b7Next

// ═══════════════════════════════════════════════════════════════════════════
// f_b7Allows — jediné, čo stratégia z celého bloku potrebuje.
// Vráti true, keď Big 7 daný smer PREPÚŠŤA. typ: 1 = LONG zóna, -1 = SHORT zóna.
// ═══════════════════════════════════════════════════════════════════════════
f_b7Allows(int typ) =>
    bool res = true
    if useBig7Filter
        if not b7InRth
            res := b7OutRth == "Prepustiť"
        else if na(b7Score)
            res := false
        else if b7Mode == "Nula"
            res := typ == 1 ? b7Score > 0 : b7Score < 0
        else if b7Mode == "Prah"
            res := typ == 1 ? b7Score >= b7Th : b7Score <= -b7Th
        else
            res := typ == 1 ? b7State == 1 : b7State == -1
    res

// ---- vizuál (voliteľný, na obchody nemá vplyv) ---- //
color b7Col = na(b7Score) ? B7_FLAT : b7Score > 0 ? B7_UP : B7_DN


bgcolor(b7ShowBg and useBig7Filter and b7InRth and not na(b7Score)
     ? color.new(b7Col, 94) : na, title="Big 7 smer")

if b7ShowTable and barstate.islast
    string b7TPos = b7TablePos == "Top Right"    ? position.top_right    :
                     b7TablePos == "Top Left"     ? position.top_left     :
                     b7TablePos == "Bottom Right" ? position.bottom_right : position.bottom_left
    var table b7Tbl = table.new(b7TPos, 2, 5, border_width=1,
         frame_color=color.new(#455a64, 40), frame_width=1, bgcolor=color.new(#0b0f14, 15))
    string b7Txt = not b7InRth ? "MIMO HODÍN"
         : na(b7Score) ? "—"
         : b7Mode == "Stav LONG/SELL" ? (b7State == 1 ? "LONG" : b7State == -1 ? "SELL" : "BEZ SMERU")
         : b7Score > 0 ? "LONG" : b7Score < 0 ? "SELL" : "BEZ SMERU"
    color b7BgC = not b7InRth or na(b7Score) ? #546e7a : b7Col
    table.cell(b7Tbl, 0, 0, "BIG 7", text_color=#0b0f14, text_size=size.small,
         text_halign=text.align_left, bgcolor=b7BgC)
    table.cell(b7Tbl, 1, 0, b7Txt, text_color=#0b0f14, text_size=size.normal,
         text_halign=text.align_center, bgcolor=b7BgC)
    table.cell(b7Tbl, 0, 1, "skóre", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 1, na(b7Score) ? "—" : str.tostring(b7Score, "+0;-0"),
         text_color=b7Col, text_size=size.normal)
    table.cell(b7Tbl, 0, 2, "šírka", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 2, str.tostring(b7Up) + " / " + str.tostring(b7Ok),
         text_color=b7Up >= b7MinBreadth ? B7_UP : b7Down >= b7MinBreadth ? B7_DN : B7_FLAT,
         text_size=size.small)
    table.cell(b7Tbl, 0, 3, "kôš", text_color=B7_FLAT, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 3, na(b7Basket) ? "—" : str.tostring(b7Basket, "+0.00;-0.00") + " %",
         text_color=na(b7Basket) ? B7_FLAT : b7Basket > 0 ? B7_UP : B7_DN, text_size=size.small)
    table.cell(b7Tbl, 0, 4, "SOXX", text_color=B7_FLAT, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 4, na(b7SoxxPct) ? "—" : str.tostring(b7SoxxPct, "+0.00;-0.00") + " %",
         text_color=na(b7SoxxPct) ? B7_FLAT : b7SoxxPct > 0 ? B7_UP : B7_DN, text_size=size.small)

// ═══════════════════ koniec bloku Big 7 ═══════════════════
