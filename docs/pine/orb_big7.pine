//@version=5
// =============================================================================
// ORB — Opening Range Breakout  +  PickMyTrade
// =============================================================================
// DEFAULTY = víťazné nastavenie na ZLATE (XAU), graf 30m:
//   obe seansy, range 15 min, vstup `close`, RRR 3.0, SL na opačnej hrane rangu,
//   okno vstupu 60 min, 2 obchody na seansu, len pracovné dni, riziko 200 $.
//   Ladený rok: 220 obchodov, 50,9 % ziskových, PF 1,89, +0,379 R na obchod.
//   Mimo ladeného roka ~+0,074 R na obchod (45 náhodných mesiacov 2016-2026).
//
// PickMyTrade je zapnuté v defaulte. Token a Account ID v súbore NIE SÚ —
// vyplň si ich v paneli. Kým sú prázdne, nič sa reálne neodošle.
// =============================================================================

strategy("ORB Opening Range Breakout + PickMyTrade", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false)

// ---------------------------------------------------------------------------
// 🕐 SEANSY
// ---------------------------------------------------------------------------
sessionMode     = input.string("both", "Ktoré seansy obchodovať", options=["both", "ny", "london"], tooltip="both = New York aj Londýn, každá má vlastný range aj vlastný obchod; ny = len New York open; london = len Londýn open.", group="🕐 Seansy")
nyStartH        = input.int(9,  "New York: otvorenie (H)", minval=0, maxval=23, group="🕐 Seansy")
nyStartM        = input.int(30, "New York: otvorenie (M)", minval=0, maxval=59, group="🕐 Seansy")
nyRangeMinutes  = input.string("15", "New York: dĺžka rangu", options=["15", "30", "60"], tooltip="Koľko minút od otvorenia NY tvorí opening range.", group="🕐 Seansy")
nyEndH          = input.int(17, "New York: koniec seansy (H)", minval=0, maxval=23, tooltip="Hodina, kedy sa NY pozície zatvárajú a prestáva sa vstupovať.", group="🕐 Seansy")
nyEndM          = input.int(55, "New York: koniec seansy (M)", minval=0, maxval=59, group="🕐 Seansy")
lonStartH       = input.int(8,  "Londýn: otvorenie (H)", minval=0, maxval=23, group="🕐 Seansy")
lonStartM       = input.int(0,  "Londýn: otvorenie (M)", minval=0, maxval=59, group="🕐 Seansy")
lonRangeMinutes = input.string("15", "Londýn: dĺžka rangu", options=["15", "30", "60"], group="🕐 Seansy")
lonEndH         = input.int(16, "Londýn: koniec seansy (H)", minval=0, maxval=23, group="🕐 Seansy")
lonEndM         = input.int(30, "Londýn: koniec seansy (M)", minval=0, maxval=59, group="🕐 Seansy")

// ---------------------------------------------------------------------------
// 🚀 VSTUP
// ---------------------------------------------------------------------------
tradeDirection     = input.string("Both", "Smer obchodov", options=["Both", "Long only", "Short only"], group="🚀 Vstup")
entryMode          = input.string("close", "Typ vstupu", options=["close", "retest", "stop"], tooltip="close = vstup na zavretí sviečky za hranicou; retest = čaká sa na návrat na prerazenú hranicu a vstup limitkou; stop = stop order priamo na hranici rangu.", group="🚀 Vstup")
breakBufferAtr     = input.float(0.1, "Buffer prerazenia (násobok ATR)", minval=0.0, maxval=2.0, step=0.01, tooltip="O koľko musí cena prekročiť hranicu, aby sa to rátalo ako prerazenie.", group="🚀 Vstup")
retestMaxBars      = input.int(10, "Retest: max barov na návrat", minval=1, maxval=100, group="🚀 Vstup")
entryWindowMinutes = input.int(60, "Vstup najneskôr do (minúty od otvorenia)", minval=0, maxval=480, tooltip="Platí zvlášť pre každú seansu, od jej vlastného otvorenia. 0 = bez obmedzenia.", group="🚀 Vstup")
maxTradesPerDay    = input.int(2, "Max obchodov na seansu a deň", minval=1, maxval=20, tooltip="Pri oboch zapnutých seansách je denné maximum dvojnásobok.", group="🚀 Vstup")

// ---------------------------------------------------------------------------
// 🚦 FILTRE
// ---------------------------------------------------------------------------
minRangePct     = input.float(0.2, "Min. šírka rangu (% ceny)", minval=0.0, maxval=5.0, step=0.05, group="🚦 Filtre")
maxRangePct     = input.float(1.5,  "Max. šírka rangu (% ceny)", minval=0.1, maxval=10.0, step=0.1, group="🚦 Filtre")
useVolumeFilter = input.bool(false, "Zapnúť volume filter", tooltip="Na CFD dátach môže byť objem nespoľahlivý.", group="🚦 Filtre")
volSmaLen       = input.int(20, "Volume: priemer za N sviečok", minval=2, maxval=200, group="🚦 Filtre")
volMultiplier   = input.float(1.5, "Volume: min. násobok priemeru", minval=0.5, maxval=10.0, step=0.1, group="🚦 Filtre")
minClosePosPct  = input.int(0, "Min. poloha zavretia v sviečke (%)", minval=0, maxval=100, tooltip="Pri LONG musí sviečka zavrieť aspoň v tejto hornej časti svojho rozsahu. Odfiltruje prerazenia s dlhým odmietacím knôtom.", group="🚦 Filtre")
weekdaysOnly    = input.bool(true, "Obchoduj len pondelok-piatok", group="🚦 Filtre")

// ---------------------------------------------------------------------------
// 🛡️ STOP LOSS
// ---------------------------------------------------------------------------
slMode        = input.string("opposite", "Umiestnenie SL", options=["opposite", "mid", "range_pct", "atr", "break_candle"], tooltip="opposite = na opačnú hranu rangu; mid = na stred rangu; range_pct = do rangu o nastavené percento jeho výšky; atr = násobok ATR od vstupu; break_candle = za low/high prerážajúcej sviečky.", group="🛡️ Stop loss")
slRangePct    = input.float(50, "SL: hĺbka do rangu (% výšky rangu)", minval=5, maxval=150, step=5, group="🛡️ Stop loss")
atrLen        = input.int(7, "ATR dĺžka", minval=2, maxval=100, group="🛡️ Stop loss")
slAtrMult     = input.float(1.0, "SL vzdialenosť (násobok ATR)", minval=0.1, maxval=10.0, step=0.1, group="🛡️ Stop loss")
slBufferAtr   = input.float(0.0, "Buffer za SL úroveň (násobok ATR)", minval=0.0, maxval=2.0, step=0.05, group="🛡️ Stop loss")
minSlDistPct  = input.float(0.2, "Min. vzdialenosť SL od vstupu (% ceny)", minval=0.0, maxval=5.0, step=0.01, tooltip="Obchod s tesnejším SL sa preskočí. 0 = vypnuté.", group="🛡️ Stop loss")

// ---------------------------------------------------------------------------
// 🎯 CIEĽ
// ---------------------------------------------------------------------------
tpMode       = input.string("rr", "Výpočet cieľa", options=["rr", "measured", "atr"], group="🎯 Cieľ")
rrRatio      = input.float(3.0, "Risk:Reward pomer", minval=0.5, maxval=10.0, step=0.1, tooltip="Take profit = rrRatio × vzdialenosť SL.", group="🎯 Cieľ")
measuredMult = input.float(1.0, "Measured move: násobok výšky rangu", minval=0.2, maxval=5.0, step=0.1, group="🎯 Cieľ")
tpAtrMult    = input.float(2.0, "TP vzdialenosť (násobok ATR)", minval=0.1, maxval=20.0, step=0.1, group="🎯 Cieľ")

// ---------------------------------------------------------------------------
// ⏱️ RIADENIE POZÍCIE
// ---------------------------------------------------------------------------
closeAtSessionEnd = input.bool(true, "Zatvor pozíciu na konci seansy", tooltip="Intradenne: pozícia sa nedrží cez noc. Zatvára ju koniec tej seansy, v ktorej vznikla.", group="⏱️ Riadenie pozície")
riskDollar        = input.float(200, "Riziko na obchod ($)", minval=0, maxval=100000, step=10, tooltip="Veľkosť pozície = riziko / vzdialenosť SL. 0 = 1 kontrakt. Minimum je vždy 1 kontrakt.", group="⏱️ Riadenie pozície")

// ---------------------------------------------------------------------------
// 🎨 VIZUALIZÁCIA
// ---------------------------------------------------------------------------
showRange  = input.bool(true, "Kresliť opening range", group="🎨 Vizualizácia")
showLevels = input.bool(true, "Kresliť hranice rangu", group="🎨 Vizualizácia")

// ---------------------------------------------------------------------------
// 🔗 PICKMYTRADE
// ---------------------------------------------------------------------------
pmtOn        = input.bool(true, "Posielať príkazy do PickMyTrade", tooltip="Kým je vypnuté, skript len simuluje v TradingView a neposiela žiadny JSON.", group="🔗 PickMyTrade")
pmtToken     = input.string("", "Token", tooltip="Svoj PickMyTrade token si vlož sám.", group="🔗 PickMyTrade")
pmtAccountId = input.string("", "Account ID", group="🔗 PickMyTrade")
pmtStratName = input.string("ORB", "Strategy name", tooltip="Musí sa zhodovať s názvom nastaveným v tvojom PickMyTrade konte.", group="🔗 PickMyTrade")
pmtMktType   = input.string("MKT", "'order_type' pre MARKET príkaz", tooltip="Over v dokumentácii PickMyTrade. Použije sa pri type vstupu close.", group="🔗 PickMyTrade")
pmtLmtType   = input.string("LMT", "'order_type' pre LIMIT príkaz", tooltip="Použije sa pri type vstupu retest.", group="🔗 PickMyTrade")
pmtStpType   = input.string("STP", "'order_type' pre STOP príkaz", tooltip="Použije sa pri type vstupu stop.", group="🔗 PickMyTrade")
pmtMode      = input.string("Order fills only", "Ako sa príkaz odošle", options=["Order fills only", "Any alert() function call", "Oboje"], tooltip="Určuje, AKÝ typ alertu musíš v TradingView vytvoriť, aby sa JSON naozaj odoslal.\n\nOrder fills only (odporúčané) = JSON visí na samotnom príkaze (alert_message) a odošle sa až vtedy, keď sa obchod SKUTOČNE vyplní. Alert vytvor s podmienkou 'Order fills only' a do správy napíš {{strategy.order.alert_message}}.\n\nAny alert() function call = JSON sa odošle hneď pri signáli, aj keď sa limitka/stopka nikdy nevyplní. Alert vytvor s podmienkou 'Any alert() function call' a správu nechaj prázdnu.\n\nOboje = pripravené sú obe cesty; vytvor si LEN JEDEN alert, inak sa príkaz odošle dvakrát.", group="🔗 PickMyTrade")
cancelPendingAtEnd = input.bool(true, "Zruš nevyplnené príkazy na konci seansy", tooltip="Týka sa len typov vstupu retest a stop (tie vytvárajú čakajúci príkaz). PickMyTrade taký príkaz zahodí sám podľa gtd_in_second — bez tohto by ho TradingView držal ďalej a simulácia by sa rozišla s realitou. Pri type vstupu close (market) nemá žiadny efekt.", group="🔗 PickMyTrade")

// =============================================================================
// 🧠 BIG 7 — filter smeru podľa koša najväčších tech titulov na Nasdaqu
// =============================================================================
// Skóre −100…+100 z piatich zložiek: kôš siedmich mega-capov, sklon jeho EMA,
// šírka (koľko zo siedmich ide rovnako), SOXX a vedenie voči QQQ. Chýbajúci
// feed vypadne AJ Z MENOVATEĽA, nepočíta sa ako nula.
//
// Do logiky ORB zasahuje jediným miestom — funkciou f_b7Allows(smer) v kroku 3
// (hľadanie prerazenia). Vypnutý filter vracia vždy true, takže stratégia sa
// správa presne ako pred jeho pridaním.
//
// Dáva zmysel len na nástrojoch naviazaných na Nasdaq (NAS100, MNQ, QQQ).
// Na zlate alebo rope je to náhodný šum, ktorý len ubelí obchody.
// =============================================================================
// !!! DÔLEŽITÉ: tieto nastavenia sa musia ZHODOVAŤ s nastaveniami samostatného
// indikátora "Big 7 + SOXX — smer Nasdaqu", ktorý máš na grafe ako panel. Obe
// skripty počítajú skóre samostatne — keď v jednom zmeníš dĺžku EMA, ukotvenie
// percent alebo váhy a v druhom nie, panel bude ukazovať iné číslo, než akým sa
// riadi filter. Predvolené hodnoty nižšie sú zhodné s indikátorom.
_GB7 = "🧠 Big 7 (smer Nasdaqu)"

useBig7Filter = input.bool(false, "Big 7: filter smeru obchodov", group=_GB7,
     tooltip="Vypnuté = presne pôvodné správanie. Zapnuté = prerazenie nahor sa berie len " +
     "keď je kôš Nasdaqu na správnej strane, nadol zrkadlovo. Vlastný 'Smer obchodov' " +
     "ostáva nadradený — z 'Long only' Big 7 shorty nespraví.")
b7Mode        = input.string("Nula", "Pravidlo", options=["Nula", "Prah", "Stav LONG/SELL"],
     group=_GB7, tooltip="Nula = stačí správna strana nuly (najmenej prísne). Prah = skóre " +
     "musí prekročiť ±Prah skóre. Stav = musí byť potvrdený signál so šírkou aj súhlasom SOXX.")
b7OutRth      = input.string("Prepustiť", "Mimo burzových hodín", options=["Prepustiť", "Blokovať"],
     group=_GB7, tooltip="Big 7 má dáta len 9:30–16:00 New York. Prepustiť = mimo toho filter " +
     "nerobí nič. Blokovať = mimo burzových hodín sa neobchoduje vôbec.")
b7Th          = input.int(40, "Prah skóre", minval=5, maxval=100, group=_GB7)
b7MinBreadth  = input.int(5, "Min. titulov na strane signálu", minval=1, maxval=7, group=_GB7)
b7NeedSoxx    = input.bool(true, "SOXX musí súhlasiť", group=_GB7)
b7Confirm     = input.int(2, "Potvrdiť N sviečok", minval=1, maxval=20, group=_GB7)
b7SkipOpen    = input.int(3, "Preskočiť prvých N sviečok dňa", minval=0, maxval=60, group=_GB7)
b7ClearMode   = input.string("Oboje", "Stav vynulovať",
     options=["Pri prechode cez nulu", "Na začiatku dňa", "Oboje", "Nikdy"], group=_GB7,
     tooltip="Bez tohto by stav držal starý smer, kým sa nepotvrdí opačný — a keby sa opačný " +
     "nepotvrdil, blokoval by jeden smer celé hodiny. Vynulovaný stav = bez smeru.")

b7Anchor      = input.string("Včerajšie zavretie", "Percentá počítať od",
     options=["Včerajšie zavretie", "Denné otvorenie"], group=_GB7,
     tooltip="Pre vnútrodenné obchodovanie dáva zmysel 'Denné otvorenie' — nočná medzera je " +
     "v momente otvorenia už zaplatená a pre ORB ťa zaujíma dnešný ťah.")
b7EmaLen      = input.int(9,    "Dĺžka EMA koša", minval=2, maxval=200, group=_GB7)
b7Smooth      = input.int(3,    "Vyhladiť skóre (EMA)", minval=1, maxval=50, group=_GB7)
b7NormPct     = input.float(1.0,  "Kôš / SOXX: plné skóre pri (%)", minval=0.05, step=0.05, group=_GB7,
     tooltip="Pohyby od otvorenia sú menšie než od včerajšieho zavretia, preto nižšia hodnota.")
b7NormSlope   = input.float(0.05, "Trend: plné skóre pri sklone", minval=0.005, step=0.005, group=_GB7,
     tooltip="Závisí od timeframu grafu. Na 30m nechaj 0,075; na 15m daj ~0,05; na 5m ~0,025.")
b7NormLead    = input.float(0.5,  "Vedenie: plné skóre pri rozdiele (%)", minval=0.05, step=0.05, group=_GB7)

b7wBasket  = input.float(1.0, "Váha: Kôš",     minval=0.0, step=0.1, group=_GB7)
b7wTrend   = input.float(1.0, "Váha: Trend",   minval=0.0, step=0.1, group=_GB7)
b7wBreadth = input.float(1.0, "Váha: Šírka",   minval=0.0, step=0.1, group=_GB7)
b7wSoxx    = input.float(1.0, "Váha: SOXX",    minval=0.0, step=0.1, group=_GB7)
b7wLead    = input.float(0.5, "Váha: Vedenie", minval=0.0, step=0.1, group=_GB7)

b7s1 = input.symbol("NASDAQ:NVDA",  "Titul 1", group=_GB7)
b7s2 = input.symbol("NASDAQ:MSFT",  "Titul 2", group=_GB7)
b7s3 = input.symbol("NASDAQ:AAPL",  "Titul 3", group=_GB7)
b7s4 = input.symbol("NASDAQ:AMZN",  "Titul 4", group=_GB7)
b7s5 = input.symbol("NASDAQ:GOOGL", "Titul 5", group=_GB7)
b7s6 = input.symbol("NASDAQ:META",  "Titul 6", group=_GB7)
b7s7 = input.symbol("NASDAQ:TSLA",  "Titul 7", group=_GB7)
b7SoxxSym = input.symbol("NASDAQ:SOXX", "Polovodiče", group=_GB7)
b7IdxSym  = input.symbol("NASDAQ:QQQ",  "Index na porovnanie", group=_GB7)

b7ShowTable = input.bool(true, "Big 7: tabuľka", group=_GB7)
b7TablePos  = input.string("Bottom Left", "Big 7: pozícia tabuľky",
     options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=_GB7)
b7ShowBg    = input.bool(false, "Big 7: podfarbiť pozadie podľa smeru", group=_GB7)

b7Palette = input.string("Neón", "Big 7: paleta", options=["Neón", "Klasika"], group=_GB7,
     tooltip="Neón = cyan / magenta, na čiernom pozadí svieti. Klasika = zelená / červená.")

color B7_UP   = b7Palette == "Neón" ? #00e5ff : #00e676
color B7_DN   = b7Palette == "Neón" ? #ff2e7e : #ff1744
color B7_FLAT = #90a4ae

// Percentuálna zmena jedného symbolu od denného ukotvenia. Obe ukotvenia naraz
// jedným dotazom — 9 symbolov × 2 volania = 18. ORB dovtedy nemala žiadne, takže
// je to 18 zo 40 povolených.
f_b7pct(simple string sym) =>
    [dOpen, dPrevClose] = request.security(sym, "D", [open, close[1]],
         barmerge.gaps_off, barmerge.lookahead_off)
    px = request.security(sym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
    anchor = b7Anchor == "Denné otvorenie" ? dOpen : dPrevClose
    na(px) or na(anchor) or anchor == 0 ? float(na) : (px - anchor) / anchor * 100.0

// EMA, ktorá sa vie resetovať. Každé volanie má vlastný stav (`var` vo funkcii).
f_b7ema(float src, simple int len, bool doReset) =>
    var float e = na
    a = 2.0 / (len + 1)
    if not na(src)
        e := na(e) or doReset ? src : e + a * (src - e)
    e

f_b7clamp(float v) => na(v) ? float(na) : math.max(-1.0, math.min(1.0, v))

b7p1 = f_b7pct(b7s1)
b7p2 = f_b7pct(b7s2)
b7p3 = f_b7pct(b7s3)
b7p4 = f_b7pct(b7s4)
b7p5 = f_b7pct(b7s5)
b7p6 = f_b7pct(b7s6)
b7p7 = f_b7pct(b7s7)
b7SoxxPct = f_b7pct(b7SoxxSym)
b7IdxPct  = f_b7pct(b7IdxSym)

b7pcts = array.from(b7p1, b7p2, b7p3, b7p4, b7p5, b7p6, b7p7)
float b7Sum = 0.0
int   b7Cnt = 0
int   b7Up  = 0
for b7i = 0 to 6
    float pv = array.get(b7pcts, b7i)
    if not na(pv)
        b7Sum += pv
        b7Cnt += 1
        if pv > 0
            b7Up += 1
int   b7Down   = b7Cnt - b7Up
float b7Basket = b7Cnt > 0 ? b7Sum / b7Cnt : float(na)

// Percentá sú ukotvené ku dňu, takže séria každé ráno skočí späť k nule —
// priebežná EMA by do dnešného otvorenia ťahala včerajšie hodnoty.
bool b7NewDay = ta.change(time("D")) != 0
var int b7BarsToday = 0
b7BarsToday := b7NewDay ? 1 : b7BarsToday + 1

float b7Ema   = f_b7ema(b7Basket, b7EmaLen, b7NewDay)
float b7Slope = b7NewDay or na(b7Ema) or na(b7Ema[1]) ? 0.0 : b7Ema - b7Ema[1]

float b7cBasket  = f_b7clamp(b7Basket / b7NormPct)
float b7cTrend   = na(b7Ema) ? float(na) : f_b7clamp(b7Slope / b7NormSlope)
float b7cBreadth = b7Cnt > 0 ? (b7Up - b7Down) / b7Cnt : float(na)
float b7cSoxx    = f_b7clamp(b7SoxxPct / b7NormPct)
float b7cLead    = na(b7Basket) or na(b7IdxPct) ? float(na) : f_b7clamp((b7Basket - b7IdxPct) / b7NormLead)

b7parts   = array.from(b7cBasket, b7cTrend, b7cBreadth, b7cSoxx, b7cLead)
b7weights = array.from(b7wBasket, b7wTrend, b7wBreadth, b7wSoxx, b7wLead)
float b7sSum = 0.0
float b7sW   = 0.0
for b7i = 0 to 4
    float cv = array.get(b7parts, b7i)
    float wv = array.get(b7weights, b7i)
    if not na(cv) and wv > 0
        b7sSum += cv * wv
        b7sW   += wv
float b7ScoreRaw = b7sW > 0 ? b7sSum / b7sW * 100.0 : float(na)
// Vyhladenie sa volá vždy, aj keď je vypnuté — funkcia so stavom sa v Pine nesmie
// volať podmienene, inak jej stav zamrzne na baroch, kde sa nezavolá.
float b7ScoreSm = f_b7ema(b7ScoreRaw, b7Smooth, b7NewDay)
float b7Score   = b7Smooth > 1 ? b7ScoreSm : b7ScoreRaw

bool b7InRth = not na(time(timeframe.period, "0930-1600", "America/New_York"))
bool b7Ready = not na(b7Score) and b7BarsToday > b7SkipOpen and b7Cnt > 0 and b7InRth

bool b7SoxxLongOk  = not b7NeedSoxx or (not na(b7SoxxPct) and b7SoxxPct > 0)
bool b7SoxxShortOk = not b7NeedSoxx or (not na(b7SoxxPct) and b7SoxxPct < 0)

bool b7LongOk  = b7Ready and b7Score >=  b7Th and b7Up   >= b7MinBreadth and b7SoxxLongOk
bool b7ShortOk = b7Ready and b7Score <= -b7Th and b7Down >= b7MinBreadth and b7SoxxShortOk

var int b7LongRun  = 0
var int b7ShortRun = 0
b7LongRun  := b7LongOk  ? b7LongRun  + 1 : 0
b7ShortRun := b7ShortOk ? b7ShortRun + 1 : 0

bool b7ClearZero = b7ClearMode == "Pri prechode cez nulu" or b7ClearMode == "Oboje"
bool b7ClearDay  = b7ClearMode == "Na začiatku dňa" or b7ClearMode == "Oboje"

var int b7State = 0
int b7Next = b7State
if b7LongRun >= b7Confirm
    b7Next := 1
else if b7ShortRun >= b7Confirm
    b7Next := -1
// Skóre prešlo na druhú stranu nuly, ale opačný signál sa (zatiaľ) nepotvrdil:
// starý smer už neplatí, nový ešte nie. To je bez smeru, nie opačný signál.
else if b7ClearZero and not na(b7Score) and ((b7State == 1 and b7Score < 0) or (b7State == -1 and b7Score > 0))
    b7Next := 0
if b7ClearDay and b7NewDay
    b7Next := 0
if barstate.isconfirmed
    b7State := b7Next

// -----------------------------------------------------------------------------
// f_b7Allows — jediné, čo ORB z celého bloku potrebuje.
// Vráti true, keď Big 7 daný smer PREPÚŠŤA. smer: 1 = long, -1 = short.
// -----------------------------------------------------------------------------
f_b7Allows(int smer) =>
    bool res = true
    if useBig7Filter
        if not b7InRth
            res := b7OutRth == "Prepustiť"
        else if na(b7Score)
            res := false
        else if b7Mode == "Nula"
            res := smer == 1 ? b7Score > 0 : b7Score < 0
        else if b7Mode == "Prah"
            res := smer == 1 ? b7Score >= b7Th : b7Score <= -b7Th
        else
            res := smer == 1 ? b7State == 1 : b7State == -1
    res

// ---- vizuál (na obchody nemá vplyv) ---- //
color b7Col = na(b7Score) ? B7_FLAT : b7Score > 0 ? B7_UP : B7_DN


bgcolor(b7ShowBg and useBig7Filter and b7InRth and not na(b7Score)
     ? color.new(b7Col, 94) : na, title="Big 7 smer")

if b7ShowTable and barstate.islast
    string b7TPos = b7TablePos == "Top Right"    ? position.top_right    :
                     b7TablePos == "Top Left"     ? position.top_left     :
                     b7TablePos == "Bottom Right" ? position.bottom_right : position.bottom_left
    var table b7Tbl = table.new(b7TPos, 2, 5, border_width=1,
         frame_color=color.new(#455a64, 40), frame_width=1, bgcolor=color.new(#0b0f14, 15))
    string b7Txt = not b7InRth ? "MIMO HODÍN"
         : na(b7Score) ? "—"
         : b7Mode == "Stav LONG/SELL" ? (b7State == 1 ? "LONG" : b7State == -1 ? "SELL" : "BEZ SMERU")
         : b7Score > 0 ? "LONG" : b7Score < 0 ? "SELL" : "BEZ SMERU"
    color b7BgC = not b7InRth or na(b7Score) ? #546e7a : b7Col
    table.cell(b7Tbl, 0, 0, "BIG 7", text_color=#0b0f14, text_size=size.small,
         text_halign=text.align_left, bgcolor=b7BgC)
    table.cell(b7Tbl, 1, 0, b7Txt, text_color=#0b0f14, text_size=size.normal,
         text_halign=text.align_center, bgcolor=b7BgC)
    table.cell(b7Tbl, 0, 1, "skóre", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 1, na(b7Score) ? "—" : str.tostring(b7Score, "+0;-0"),
         text_color=b7Col, text_size=size.normal)
    table.cell(b7Tbl, 0, 2, "šírka", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 2, str.tostring(b7Up) + " / " + str.tostring(b7Cnt),
         text_color=b7Up >= b7MinBreadth ? B7_UP : b7Down >= b7MinBreadth ? B7_DN : B7_FLAT,
         text_size=size.small)
    table.cell(b7Tbl, 0, 3, "kôš", text_color=B7_FLAT, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 3, na(b7Basket) ? "—" : str.tostring(b7Basket, "+0.00;-0.00") + " %",
         text_color=na(b7Basket) ? B7_FLAT : b7Basket > 0 ? B7_UP : B7_DN, text_size=size.small)
    table.cell(b7Tbl, 0, 4, "SOXX", text_color=B7_FLAT, text_size=size.small, text_halign=text.align_left)
    table.cell(b7Tbl, 1, 4, na(b7SoxxPct) ? "—" : str.tostring(b7SoxxPct, "+0.00;-0.00") + " %",
         text_color=na(b7SoxxPct) ? B7_FLAT : b7SoxxPct > 0 ? B7_UP : B7_DN, text_size=size.small)

// =============================================================================
// PICKMYTRADE — správy
// =============================================================================
pmtMsg(string dir, float price, float tp, float sl, int qty, string orderType, int gtdSec) =>
    string p = str.tostring(price, "#.######")
    string t = str.tostring(tp,    "#.######")
    string s = str.tostring(sl,    "#.######")
    string g = str.tostring(gtdSec)
    string q = str.tostring(qty)
    '{"strategy_name":"' + pmtStratName + '","symbol":"' + syminfo.ticker + '","date":"{{timenow}}","data":"' + dir + '","quantity":' + q + ',"risk_percentage":0,"price":"' + p + '","gtd_in_second":' + g + ',"stp_limit_stp_price":0,"tp":"' + t + '","percentage_tp":0,"dollar_tp":0,"sl":"' + s + '","percentage_sl":0,"dollar_sl":0,"trail":0,"trail_stop":0,"trail_trigger":0,"trail_freq":0,"update_tp":false,"update_sl":false,"breakeven":0,"breakeven_offset":0,"token":"' + pmtToken + '","pyramid":false,"same_direction_ignore":false,"reverse_order_close":true,"order_type":"' + orderType + '","multiple_accounts":[{"token":"' + pmtToken + '","account_id":"' + pmtAccountId + '","risk_percentage":0,"quantity_multiplier":1}]}'

pmtCloseMsg() =>
    '{"strategy_name":"' + pmtStratName + '","symbol":"' + syminfo.ticker + '","date":"{{timenow}}","data":"close","quantity":1,"risk_percentage":0,"price":"{{close}}","gtd_in_second":0,"stp_limit_stp_price":0,"dollar_tp":0,"percentage_tp":0,"tp":0,"dollar_sl":0,"percentage_sl":0,"sl":0,"trail":0,"trail_stop":0,"trail_trigger":0,"trail_freq":0,"update_tp":false,"update_sl":false,"breakeven":0,"breakeven_offset":0,"token":"' + pmtToken + '","pyramid":false,"same_direction_ignore":false,"reverse_order_close":true,"multiple_accounts":[{"token":"' + pmtToken + '","account_id":"' + pmtAccountId + '","risk_percentage":0,"quantity_multiplier":1}]}'

// Dve nezávislé cesty, ako sa JSON dostane do PickMyTrade. `alert_message` visí na
// príkaze a odošle sa až pri jeho skutočnom vyplnení; `alert()` sa odošle hneď pri
// signáli. Ktorá z nich zafunguje, rozhoduje typ alertu vytvorený v TradingView —
// preto sú obe pripravené a vstup vyššie len hovorí, ktorú plníš obsahom.
bool pmtViaFill  = pmtOn and (pmtMode == "Order fills only" or pmtMode == "Oboje")
bool pmtViaAlert = pmtOn and (pmtMode == "Any alert() function call" or pmtMode == "Oboje")

// =============================================================================
// SPOLOČNÉ VÝPOČTY
// =============================================================================
atrVal      = ta.atr(atrLen)
volAvg      = ta.sma(volume, volSmaLen)

nyOn  = sessionMode == "both" or sessionMode == "ny"
lonOn = sessionMode == "both" or sessionMode == "london"

allowLong  = tradeDirection == "Both" or tradeDirection == "Long only"
allowShort = tradeDirection == "Both" or tradeDirection == "Short only"

// Stav každej seansy. Index 0 = New York, 1 = Londýn.
var int[]   stDay    = array.new_int(2, 0)
var float[] stHi     = array.new_float(2, na)
var float[] stLo     = array.new_float(2, na)
var bool[]  stClosed = array.new_bool(2, false)
var bool[]  stOk     = array.new_bool(2, false)
var int[]   stTrades = array.new_int(2, 0)
var int[]   stDir    = array.new_int(2, 0)
var float[] stLevel  = array.new_float(2, na)
var int[]   stBrkBar = array.new_int(2, 0)
var float[] stBrkExt = array.new_float(2, na)
var int[]   stOpenMs = array.new_int(2, 0)

var int openedBy = -1

var int   sigDir   = 0
var float sigEntry = na
var float sigSl    = na
var float sigTp    = na
var int   sigQty   = 0
var bool  sigClose = false
sigDir   := 0
sigEntry := na
sigSl    := na
sigTp    := na
sigQty   := 0
sigClose := false

// =============================================================================
// LOGIKA SEANSY
// =============================================================================
for i = 0 to 1
    bool aktivna = i == 0 ? nyOn : lonOn
    if aktivna
        string tz      = i == 0 ? "America/New_York" : "Europe/London"
        int startMin   = (i == 0 ? nyStartH : lonStartH) * 60 + (i == 0 ? nyStartM : lonStartM)
        int rangeMin   = int(str.tonumber(i == 0 ? nyRangeMinutes : lonRangeMinutes))
        int endMin     = (i == 0 ? nyEndH : lonEndH) * 60 + (i == 0 ? nyEndM : lonEndM)
        int rangeEnd   = startMin + rangeMin

        int  dow     = dayofweek(time, tz)
        bool vikend  = dow == dayofweek.saturday or dow == dayofweek.sunday
        if not (weekdaysOnly and vikend)
            int minuty = hour(time, tz) * 60 + minute(time, tz)
            int denId  = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)

            // nový deň — vynuluj stav seansy
            if array.get(stDay, i) != denId
                array.set(stDay, i, denId)
                array.set(stHi, i, na)
                array.set(stLo, i, na)
                array.set(stClosed, i, false)
                array.set(stOk, i, false)
                array.set(stTrades, i, 0)
                array.set(stDir, i, 0)
                array.set(stBrkBar, i, 0)
                array.set(stOpenMs, i, 0)

            // ---- 1. stavanie rangu ----------------------------------------
            if minuty >= startMin and minuty < rangeEnd
                array.set(stHi, i, na(array.get(stHi, i)) ? high : math.max(array.get(stHi, i), high))
                array.set(stLo, i, na(array.get(stLo, i)) ? low  : math.min(array.get(stLo, i), low))
                if array.get(stOpenMs, i) == 0
                    array.set(stOpenMs, i, time)

            // ---- 2. range práve uzavretý ----------------------------------
            else if not array.get(stClosed, i) and minuty >= rangeEnd and not na(array.get(stHi, i)) and not na(array.get(stLo, i))
                array.set(stClosed, i, true)
                float hiV = array.get(stHi, i)
                float loV = array.get(stLo, i)
                float sirka = close > 0 ? (hiV - loV) / close * 100.0 : 0.0
                array.set(stOk, i, sirka >= minRangePct and sirka <= maxRangePct)
                int zaciatokMs = array.get(stOpenMs, i) > 0 ? array.get(stOpenMs, i) : time
                int koniecMs   = time + math.max(endMin - minuty, 1) * 60000
                if showRange and array.get(stOk, i)
                    box.new(zaciatokMs, hiV, time, loV, xloc=xloc.bar_time, border_color=color.new(color.blue, 40), bgcolor=color.new(color.blue, 88))
                if showLevels and array.get(stOk, i)
                    line.new(time, hiV, koniecMs, hiV, xloc=xloc.bar_time, color=color.new(color.blue, 30), width=1)
                    line.new(time, loV, koniecMs, loV, xloc=xloc.bar_time, color=color.new(color.blue, 30), width=1)

            // ---- 6. koniec seansy -----------------------------------------
            if minuty >= endMin
                if closeAtSessionEnd and strategy.position_size != 0 and openedBy == i
                    sigClose := true
                array.set(stDir, i, 0)

            // ---- obchodné okno --------------------------------------------
            else if array.get(stClosed, i) and array.get(stOk, i) and minuty >= rangeEnd
                bool vOkne    = entryWindowMinutes == 0 or minuty <= startMin + entryWindowMinutes
                bool jeMiesto = array.get(stTrades, i) < maxTradesPerDay
                bool volno    = strategy.position_size == 0 and sigDir == 0
                if vOkne and jeMiesto and volno
                    float hiV = array.get(stHi, i)
                    float loV = array.get(stLo, i)
                    float buf = breakBufferAtr * atrVal

                    // ---- 3. hľadanie prerazenia ---------------------------
                    if array.get(stDir, i) == 0
                        // Big 7 filter smeru — vypnutý vracia vždy true, takže bez neho
                        // je to presne pôvodná podmienka prerazenia.
                        bool brkLong  = allowLong  and close > hiV + buf and f_b7Allows(1)
                        bool brkShort = allowShort and close < loV - buf and f_b7Allows(-1)
                        if brkLong or brkShort
                            bool volOk = not useVolumeFilter or (not na(volAvg) and volAvg > 0 and volume >= volAvg * volMultiplier)
                            float span = high - low
                            float pos  = span > 0 ? (close - low) / span * 100.0 : 100.0
                            bool posOk = span <= 0 or (brkLong ? pos >= minClosePosPct : (100.0 - pos) >= minClosePosPct)
                            if volOk and posOk
                                array.set(stDir, i, brkLong ? 1 : -1)
                                array.set(stLevel, i, brkLong ? hiV : loV)
                                array.set(stBrkBar, i, bar_index)
                                array.set(stBrkExt, i, brkLong ? low : high)
                                if entryMode != "retest"
                                    sigDir   := brkLong ? 1 : -1
                                    sigEntry := entryMode == "close" ? close : array.get(stLevel, i)

                    // ---- 4. retest ----------------------------------------
                    else if entryMode == "retest"
                        if bar_index - array.get(stBrkBar, i) > retestMaxBars
                            array.set(stDir, i, 0)
                        else
                            bool jeLong = array.get(stDir, i) == 1
                            float lvl   = array.get(stLevel, i)
                            bool dotyk  = jeLong ? low <= lvl : high >= lvl
                            if dotyk
                                sigDir   := jeLong ? 1 : -1
                                sigEntry := lvl

                    // ---- 5. výpočet SL, TP a veľkosti ---------------------
                    if sigDir != 0
                        bool jeLong = sigDir == 1
                        float hiR = array.get(stHi, i)
                        float loR = array.get(stLo, i)
                        float zaklad = switch slMode
                            "opposite"     => jeLong ? loR : hiR
                            "mid"          => (hiR + loR) / 2.0
                            "range_pct"    => jeLong ? hiR - (hiR - loR) * slRangePct / 100.0 : loR + (hiR - loR) * slRangePct / 100.0
                            "break_candle" => array.get(stBrkExt, i)
                            => jeLong ? sigEntry - slAtrMult * atrVal : sigEntry + slAtrMult * atrVal
                        float slBuf = slBufferAtr * atrVal
                        sigSl := jeLong ? zaklad - slBuf : zaklad + slBuf

                        float slDist = math.abs(sigEntry - sigSl)
                        float minSl  = minSlDistPct > 0 ? close * minSlDistPct / 100.0 : 0.0
                        if slDist < syminfo.mintick * 2 or (minSl > 0 and slDist < minSl)
                            sigDir   := 0
                            sigEntry := na
                            sigSl    := na
                            array.set(stDir, i, 0)
                        else
                            float tpDist = switch tpMode
                                "rr"       => slDist * rrRatio
                                "measured" => (hiR - loR) * measuredMult
                                => tpAtrMult * atrVal
                            sigTp := jeLong ? sigEntry + tpDist : sigEntry - tpDist
                            if (jeLong and sigTp <= sigEntry) or (not jeLong and sigTp >= sigEntry)
                                sigDir   := 0
                                array.set(stDir, i, 0)
                            else
                                float bodHodnota = syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0
                                sigQty := riskDollar > 0 ? int(math.max(1, math.floor(riskDollar / (slDist * bodHodnota)))) : 1
                                array.set(stTrades, i, array.get(stTrades, i) + 1)
                                array.set(stDir, i, 0)
                                openedBy := i

// =============================================================================
// VYKONANIE — TradingView simulácia + alert do PickMyTrade
// =============================================================================
if sigClose and strategy.position_size != 0
    strategy.close_all(comment="koniec seansy", alert_message=pmtViaFill ? pmtCloseMsg() : "")
    if pmtViaAlert
        alert(pmtCloseMsg(), alert.freq_once_per_bar_close)
    openedBy := -1

// Nevyplnená limitka/stopka z končiacej seansy už nemá čo robiť. PickMyTrade ju
// zahodí sám podľa gtd_in_second — TradingView by ju držal ďalej a simulácia by sa
// rozišla s tým, čo naozaj beží u brokera. Pri vstupe `close` tu nie je čo rušiť.
if cancelPendingAtEnd and sigClose
    strategy.cancel_all()

if sigDir != 0 and strategy.position_size == 0
    bool jeLong = sigDir == 1
    string smer = jeLong ? "long" : "short"
    string id   = jeLong ? "ORB long" : "ORB short"
    string ot   = entryMode == "close" ? pmtMktType : entryMode == "stop" ? pmtStpType : pmtLmtType
    int    gtd  = math.max(60, entryWindowMinutes * 60)
    // JSON sa skladá RAZ a použije sa pre obe cesty, nech sa nemôžu rozísť.
    string msgIn   = pmtMsg(smer, sigEntry, sigTp, sigSl, sigQty, ot, gtd)
    string msgFill = pmtViaFill ? msgIn : ""

    if entryMode == "close"
        strategy.entry(id, jeLong ? strategy.long : strategy.short, qty=sigQty, alert_message=msgFill)
    else if entryMode == "stop"
        strategy.entry(id, jeLong ? strategy.long : strategy.short, qty=sigQty, stop=sigEntry, alert_message=msgFill)
    else
        strategy.entry(id, jeLong ? strategy.long : strategy.short, qty=sigQty, limit=sigEntry, alert_message=msgFill)

    // Bezpečnostná poistka: keď TP/SL zoberie TradingView, pošle sa do PickMyTrade
    // aj príkaz na zatvorenie. PickMyTrade má svoj vlastný bracket z entry JSON-u,
    // takže je to druhá vrstva, nie jediná.
    strategy.exit("exit " + id, from_entry=id, stop=sigSl, limit=sigTp,
         alert_message=pmtViaFill ? pmtCloseMsg() : "")

    if pmtViaAlert
        alert(msgIn, alert.freq_once_per_bar_close)

if strategy.position_size == 0 and openedBy != -1 and not sigClose and sigDir == 0
    openedBy := -1

plot(atrVal, "ATR", display=display.none)
