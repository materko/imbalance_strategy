//@version=5
// Big 7 + SOXX — nástroj na určovanie smeru Nasdaqu.
//
// Skladá päť nezávislých pohľadov na to isté do jedného skóre −100…+100:
//
//   1. KÔŠ      kde sú dnes vážené percentá siedmich najväčších tech titulov
//   2. TREND    sklon EMA nad košom — ide to hore alebo dole
//   3. ŠÍRKA    koľko zo siedmich je na tej istej strane (priemer +0,8 % môže byť
//               NVDA +6 % a šesť v mínuse; to nie je trend, to je jeden ťahúň)
//   4. SOXX     polovodiče, ktoré Nasdaqu historicky chodia napred
//   5. VEDENIE  o koľko kôš prekonáva samotný index (QQQ) — či ťah nesú mega-capy,
//               alebo ide trh naozaj celý
//
// Každý pohľad má vlastnú váhu a chýbajúci feed z výpočtu vypadne aj z menovateľa,
// takže mlčiaci symbol skóre neťahá k nule.
//
// Presnosť: EMA sa na začiatku dňa resetuje (percentá sú ukotvené k dňu, priebežná
// EMA by do rána ťahala včerajšok), stav sa mení až na zavretí sviečky a musí
// vydržať N sviečok, prvé sviečky dňa sú hluché a mimo burzových hodín sa
// nesignalizuje, lebo vtedy sú akciové feedy stojaté.

indicator("Big 7 + SOXX — smer Nasdaqu", overlay=false, precision=2, max_labels_count=50)

// ---------------------------------------------------------------- kôš --- //
_GK = "Kôš Big 7"
s1 = input.symbol("NASDAQ:NVDA",  "1", group=_GK, inline="a1")
w1 = input.float(1.0, "váha",     group=_GK, inline="a1", minval=0.0, step=0.1)
s2 = input.symbol("NASDAQ:MSFT",  "2", group=_GK, inline="a2")
w2 = input.float(1.0, "váha",     group=_GK, inline="a2", minval=0.0, step=0.1)
s3 = input.symbol("NASDAQ:AAPL",  "3", group=_GK, inline="a3")
w3 = input.float(1.0, "váha",     group=_GK, inline="a3", minval=0.0, step=0.1)
s4 = input.symbol("NASDAQ:AMZN",  "4", group=_GK, inline="a4")
w4 = input.float(1.0, "váha",     group=_GK, inline="a4", minval=0.0, step=0.1)
s5 = input.symbol("NASDAQ:GOOGL", "5", group=_GK, inline="a5")
w5 = input.float(1.0, "váha",     group=_GK, inline="a5", minval=0.0, step=0.1)
s6 = input.symbol("NASDAQ:META",  "6", group=_GK, inline="a6")
w6 = input.float(1.0, "váha",     group=_GK, inline="a6", minval=0.0, step=0.1)
s7 = input.symbol("NASDAQ:TSLA",  "7", group=_GK, inline="a7")
w7 = input.float(1.0, "váha",     group=_GK, inline="a7", minval=0.0, step=0.1)
weightMode = input.string("Rovnaká váha", "Váženie", options=["Rovnaká váha", "Vlastné váhy"],
     group=_GK, tooltip="Vlastné váhy = do políčok napíš trhové kapitalizácie alebo váhy " +
     "z indexu. Normalizujú sa samy, takže nemusia dávať súčet 1.")

// ------------------------------------------------------------ kontext --- //
_GC = "Sektor a index"
soxxSym = input.symbol("NASDAQ:SOXX", "Polovodiče", group=_GC,
     tooltip="SOXX (alebo SMH, prípadne index SOX). Polovodiče Nasdaqu chodia napred — " +
     "keď kôš stúpa a semis nie, ťah býva krátky.")
idxSym  = input.symbol("NASDAQ:QQQ",  "Index na porovnanie", group=_GC,
     tooltip="QQQ alebo NDX. Slúži na VEDENIE: o koľko kôš prekonáva index. Kôš silno hore " +
     "a index nikam = úzky ťah niekoľkých mien, krehký.")

// ------------------------------------------------ reakcia na správy --- //
// Pine nevie prečítať text správy — žiadne API na to nie je. Vie však prečítať,
// ako trh na správu REAGUJE, a to sa dá rozobrať na tri merateľné veci:
// odkiaľ správa prišla (rozptyl), ako tvrdo dopadla (impulz) a či trh dostal
// strach (VIX). Celý blok je dodatok: predvolene nič neblokuje, len ukazuje.
_GN2 = "📰 Reakcia na správy"
useNews   = input.bool(false, "Zapnúť blok správ", group=_GN2,
     tooltip="Predvolene vypnutý — indikátor beží bez neho presne tak, ako predtým, " +
     "a nerobí ani dotazy na VIX. Zapni, len keď ťa reakcia na správy zaujíma.")
vixSym    = input.symbol("CBOE:VIX", "Index strachu", group=_GN2,
     tooltip="VIX skáče na headlinoch skôr, než sa stihne prečítať, čo sa stalo.")
vixJump   = input.float(3.0, "VIX: skok od (%)", minval=0.5, step=0.5, group=_GN2)
vixVeto   = input.bool(false, "VIX blokuje LONG", group=_GN2,
     tooltip="Zapnuté: keď VIX vyskočí nad prah, LONG signál nevznikne. Predvolene vypnuté — " +
     "blok správ má najprv informovať, nie rozhodovať.")
impWin    = input.int(6, "Impulz: okno (sviečok)", minval=2, maxval=60, group=_GN2,
     tooltip="Za koľko sviečok sa meria náhly pohyb koša.")
impK      = input.float(2.5, "Impulz: koľko sigma je náhle", minval=1.0, step=0.5, group=_GN2)
dispMacro = input.float(0.8, "Rozptyl: pod týmto je to makro", minval=0.1, step=0.1, group=_GN2,
     tooltip="Rozptyl delený veľkosťou pohybu koša. Nízky = všetkých sedem ide spolu, " +
     "čiže za tým je makro správa (CPI, Fed). Vysoký = ťahá to jeden titul.")
dispSingle = input.float(1.5, "Rozptyl: nad týmto ťahá jeden titul", minval=0.2, step=0.1, group=_GN2)

// ----------------------------------------------------------- výpočet --- //
_GV = "Výpočet"
anchorMode = input.string("Včerajšie zavretie", "Percentá počítať od",
     options=["Včerajšie zavretie", "Denné otvorenie"], group=_GV,
     tooltip="Včerajšie zavretie = denná zmena, akú ukazujú burzové weby (obsahuje nočnú " +
     "medzeru, kde pri tech tituloch býva väčšina pohybu). Denné otvorenie = len dnešná seansa.")
emaLen     = input.int(9, "Dĺžka EMA koša", minval=2, maxval=200, group=_GV)
resetDaily = input.bool(true, "Resetovať EMA na začiatku dňa", group=_GV,
     tooltip="Zapnuté (odporúčané): EMA aj skóre začínajú každý deň odznova. Vypnuté: " +
     "prvé hodiny dňa ťahajú včerajšie hodnoty.")

// -------------------------------------------------------------- skóre --- //
_GP = "Skóre — váhy zložiek"
wBasket  = input.float(1.0, "Kôš",     minval=0.0, step=0.1, group=_GP)
wTrend   = input.float(1.0, "Trend",   minval=0.0, step=0.1, group=_GP)
wBreadth = input.float(1.0, "Šírka",   minval=0.0, step=0.1, group=_GP)
wSoxx    = input.float(1.0, "SOXX",    minval=0.0, step=0.1, group=_GP)
wLead    = input.float(0.5, "Vedenie", minval=0.0, step=0.1, group=_GP)

_GN = "Skóre — kedy je zložka na plno"
normPct   = input.float(1.0,  "Kôš / SOXX: plné skóre pri (%)", minval=0.05, step=0.05, group=_GN,
     tooltip="Pri akej percentuálnej zmene dá zložka ±100. Nižšie číslo = citlivejšie skóre.")
normSlope = input.float(0.05, "Trend: plné skóre pri sklone", minval=0.005, step=0.005, group=_GN)
normLead  = input.float(0.5,  "Vedenie: plné skóre pri rozdiele (%)", minval=0.05, step=0.05, group=_GN)

// ------------------------------------------------------------ signál --- //
_GS = "Signál"
scoreSmooth = input.int(3, "Vyhladiť skóre (EMA)", minval=1, maxval=50, group=_GS,
     tooltip="1 = bez vyhladenia.")
scoreTh     = input.int(40, "Prah skóre", minval=5, maxval=100, group=_GS)
minBreadth  = input.int(5, "Min. titulov na strane signálu", minval=1, maxval=7, group=_GS)
needSoxx    = input.bool(true, "SOXX musí súhlasiť", group=_GS,
     tooltip="Signál nevznikne, keď sú polovodiče na opačnej strane než kôš.")
confirmBars = input.int(2, "Potvrdiť N sviečok", minval=1, maxval=20, group=_GS)
skipOpen    = input.int(3, "Preskočiť prvých N sviečok dňa", minval=0, maxval=60, group=_GS,
     tooltip="Čerstvo resetovaná EMA sa rovná samotnému košu, sklon z nej ešte nič nehovorí.")
onlyRth     = input.bool(true, "Len počas burzových hodín", group=_GS,
     tooltip="Mimo 9:30–16:00 New York sú akciové feedy stojaté a skóre zamrzne na poslednej " +
     "hodnote. Vypni len vtedy, keď vedome sleduješ predburzu.")
onClose     = input.bool(true, "Signál až na zavretí sviečky", group=_GS,
     tooltip="Zapnuté: indikátor neprekresľuje.")
clearMode   = input.string("Oboje", "Stav vynulovať",
     options=["Pri prechode cez nulu", "Na začiatku dňa", "Oboje", "Nikdy"], group=_GS,
     tooltip="Bez tohto stav drží, kým sa nepotvrdí OPAČNÝ signál — a keď sa opačný nikdy " +
     "nepotvrdí (napr. kvôli vetu SOXX), pozadie svieti starou farbou celé hodiny, hoci " +
     "skóre je dávno na druhej strane. Vynulovaný stav = BEZ SMERU, nie opačný signál.")

// ---------------------------------------------------------- zobraz. --- //
_GZ = "Zobrazenie"
viewMode    = input.string("Skóre smeru", "Čo kresliť", options=["Skóre smeru", "Percentá koša"],
     group=_GZ, tooltip="Skóre a percentá majú inú mierku, preto sa kreslia zvlášť. " +
     "V oboch režimoch je všetko aj v Data Window.")
showParts   = input.bool(false, "Kresliť zložky skóre", group=_GZ,
     tooltip="Štyri tenké čiary v mierke skóre — vidno, ktorá zložka skóre ťahá a ktorá mu " +
     "odporuje.")
palette     = input.string("Neón", "Paleta", options=["Neón", "Klasika"], group=_GZ,
     tooltip="Neón = cyan / magenta, na čiernom pozadí svieti. Klasika = zelená / červená.")
shapeMode   = input.string("Plocha", "Tvar skóre", options=["Plocha", "Histogram", "Oboje"],
     group=_GZ)
useGlow     = input.bool(true, "Žiara okolo čiary", group=_GZ,
     tooltip="Čiara sa kreslí v troch vrstvách nad sebou, každá širšia a priesvitnejšia. " +
     "Vypni, ak ti to na svetlom pozadí rozmazáva obraz.")
markOnChart = input.bool(true, "Značky aj na cenovom grafe", group=_GZ,
     tooltip="LONG/SELL sa kreslí aj k sviečkam, nielen do panelu.")
showState   = input.bool(true,  "Podfarbiť pozadie podľa stavu", group=_GZ)
showWarn    = input.bool(true,  "Značky varovaní", group=_GZ)
tablePos    = input.string("Vpravo hore", "Tabuľka — kde",
     options=["Vpravo hore", "Vpravo dole", "Vľavo hore", "Vľavo dole"], group=_GZ)
tableSize   = input.string("Stredná", "Tabuľka — rozsah",
     options=["Len smer", "Kompaktná", "Stredná", "Plná"], group=_GZ,
     tooltip="Len smer = 1 riadok. Kompaktná = smer, skóre, šírka. Stredná = + kôš, SOXX, " +
     "index. Plná = + všetkých sedem titulov (13 riadkov, na nízkom paneli sa odreže).")
showTable   = input.bool(true,  "Tabuľka", group=_GZ)

// ------------------------------------------------------------ farby --- //
// Ladené na ČIERNE pozadie: plné, sýte tóny, žiadna sivá polopriesvitná čiara.
C_WARN   = #ff9100   // impulz / úzky ťah
C_WARN2  = #ffea00   // skok VIX
neon     = palette == "Neón"
C_UP     = neon ? #00e5ff : #00e676   // smer hore
C_DN     = neon ? #ff2e7e : #ff1744   // smer dole
C_FLAT   = #90a4ae   // bez smeru
C_SOXX   = #e040fb
C_BREAD  = #ffd740
C_LEAD   = #ff9100
C_TREND  = #69f0ae

// ------------------------------------------------------------------ //
// Percentuálna zmena jedného symbolu od denného ukotvenia. Obe ukotvenia
// naraz jedným dotazom — `request.security` sa nesmie volať podmienene.
// ------------------------------------------------------------------ //
f_pct(sym) =>
    [dOpen, dPrevClose] = request.security(sym, "D", [open, close[1]],
         barmerge.gaps_off, barmerge.lookahead_off)
    px = request.security(sym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
    anchor = anchorMode == "Denné otvorenie" ? dOpen : dPrevClose
    na(px) or na(anchor) or anchor == 0 ? float(na) : (px - anchor) / anchor * 100.0

//: EMA, ktorá sa vie resetovať. Každé volanie má vlastný stav (`var` vo funkcii).
f_ema(src, len, doReset) =>
    var float e = na
    a = 2.0 / (len + 1)
    if not na(src)
        e := na(e) or doReset ? src : e + a * (src - e)
    e

f_clamp(v, lim) => na(v) ? float(na) : math.max(-lim, math.min(lim, v))

p1 = f_pct(s1)
p2 = f_pct(s2)
p3 = f_pct(s3)
p4 = f_pct(s4)
p5 = f_pct(s5)
p6 = f_pct(s6)
p7 = f_pct(s7)
soxxPct = f_pct(soxxSym)
idxPct  = f_pct(idxSym)

pcts = array.from(p1, p2, p3, p4, p5, p6, p7)
wts  = array.from(w1, w2, w3, w4, w5, w6, w7)

// Vážený priemer len z titulov, ktoré naozaj majú dáta — chýbajúci sa nevynuluje,
// ale vypadne aj z menovateľa.
pSum = 0.0
wSum = 0.0
nOk  = 0
nUp  = 0
for i = 0 to 6
    p = array.get(pcts, i)
    w = weightMode == "Rovnaká váha" ? 1.0 : array.get(wts, i)
    if not na(p) and w > 0
        pSum += p * w
        wSum += w
        nOk  += 1
        if p > 0
            nUp += 1
nDown     = nOk - nUp
basketPct = wSum > 0 ? pSum / wSum : float(na)

// ------------------------------------------------ reakcia na správy --- //
// 1. ROZPTYL — vážená smerodajná odchýlka siedmich percent okolo koša.
//    Makro správa (CPI, Fed, clá) hýbe všetkými naraz, takže rozptyl je malý.
//    Správa o jednej firme (earnings, žaloba) roztiahne pole a rozptyl vyskočí.
dSum = 0.0
for i = 0 to 6
    pv = array.get(pcts, i)
    wv = weightMode == "Rovnaká váha" ? 1.0 : array.get(wts, i)
    if not na(pv) and wv > 0 and not na(basketPct)
        dSum += wv * math.pow(pv - basketPct, 2)
disp = wSum > 0 and nOk > 1 ? math.sqrt(dSum / wSum) : float(na)
//: rozptyl vztiahnutý k veľkosti pohybu — bez toho by veľký deň vyzeral vždy „rozhádzane"
dispRel = na(disp) or na(basketPct) ? float(na) : disp / math.max(math.abs(basketPct), normPct * 0.2)

// 2. IMPULZ — o koľko sigma sa kôš pohol za posledných `impWin` sviečok oproti tomu,
//    ako sa hýbal doteraz. Správa sa v cene prejaví ako náhly skok, nie ako plynulý drift.
impChg = na(basketPct) ? float(na) : basketPct - nz(basketPct[impWin], basketPct)
impSig = ta.stdev(nz(impChg), 100)
imp    = na(impChg) or impSig <= 0 ? float(na) : impChg / impSig

// 3. VIX — index strachu. Na headlinoch skáče skôr, než sa stihne prečítať, čo sa stalo.
vixPct = f_pct(vixSym)

// --------------------------------------------------- EMA s resetom --- //
newDay = ta.change(time("D")) != 0
var int barsToday = 0
barsToday := newDay ? 1 : barsToday + 1
doReset = resetDaily and newDay

basketEma = f_ema(basketPct, emaLen, doReset)
// Na resetovej sviečke nie je sklon definovaný — inak by z neho vyšiel skok
// z včerajšej hodnoty na dnešnú nulu.
emaSlope = doReset or na(basketEma) or na(basketEma[1]) ? 0.0 : basketEma - basketEma[1]

// ------------------------------------------------- zložky skóre --- //
// Každá je −1…+1; chýbajúca (na) sa z priemeru vynechá aj s váhou.
cBasket  = na(basketPct) ? float(na) : f_clamp(basketPct / normPct, 1.0)
cTrend   = na(basketEma) ? float(na) : f_clamp(emaSlope / normSlope, 1.0)
cBreadth = nOk > 0 ? (nUp - nDown) / nOk : float(na)
cSoxx    = na(soxxPct) ? float(na) : f_clamp(soxxPct / normPct, 1.0)
cLead    = na(basketPct) or na(idxPct) ? float(na) : f_clamp((basketPct - idxPct) / normLead, 1.0)

parts   = array.from(cBasket, cTrend, cBreadth, cSoxx, cLead)
pWeights = array.from(wBasket, wTrend, wBreadth, wSoxx, wLead)
sSum = 0.0
sW   = 0.0
for i = 0 to 4
    c = array.get(parts, i)
    w = array.get(pWeights, i)
    if not na(c) and w > 0
        sSum += c * w
        sW   += w
scoreRaw = sW > 0 ? sSum / sW * 100.0 : float(na)
// Vyhladenie sa volá vždy, aj keď je vypnuté — funkcia so stavom (`var`) sa v Pine
// nesmie volať podmienene, inak jej stav zamrzne na baroch, kde sa nezavolá.
scoreSm  = f_ema(scoreRaw, scoreSmooth, doReset)
score    = scoreSmooth > 1 ? scoreSm : scoreRaw

// ------------------------------------------------- stav LONG/SELL --- //
inRth = not onlyRth or not na(time(timeframe.period, "0930-1600", "America/New_York"))
ready = not na(score) and barsToday > skipOpen and nOk > 0 and inRth

// ---- vyhodnotenie bloku správ ---- //
newsOn     = useNews and ready
//: VIX vyskočil — trh dostal strach, nech už ho vyvolalo čokoľvek
vixSpike   = newsOn and not na(vixPct) and vixPct >= vixJump
//: kôš sa pohol náhle, nie driftom — tak vyzerá cena po správe
impulse    = newsOn and not na(imp) and math.abs(imp) >= impK
//: všetkých sedem ide spolu = za tým je makro (CPI, Fed, clá)
macroMove  = newsOn and not na(dispRel) and dispRel <= dispMacro
     and math.abs(nz(basketPct)) > normPct * 0.3
//: pole je roztiahnuté = ťahá to jeden titul, priemer o skupine nehovorí
singleMove = newsOn and not na(dispRel) and dispRel >= dispSingle

newsTxt = not useNews ? "—"
     : vixSpike   ? "VIX SKOK"
     : impulse and macroMove  ? "MAKRO ⚡"
     : impulse and singleMove ? "JEDEN TITUL ⚡"
     : impulse                ? "IMPULZ ⚡"
     : macroMove  ? "makro"
     : singleMove ? "jeden titul" : "pokoj"
newsCol = vixSpike ? C_WARN2 : impulse ? C_WARN : macroMove ? C_FLAT : singleMove ? C_WARN : C_FLAT

soxxLongOk  = not needSoxx or (not na(soxxPct) and soxxPct > 0)
soxxShortOk = not needSoxx or (not na(soxxPct) and soxxPct < 0)

// VIX blokuje len LONG — strach je asymetrický, rastúci VIX pádom neprekáža.
longOk  = ready and score >=  scoreTh and nUp   >= minBreadth and soxxLongOk
     and not (vixVeto and vixSpike)
shortOk = ready and score <= -scoreTh and nDown >= minBreadth and soxxShortOk

var int longRun  = 0
var int shortRun = 0
longRun  := longOk  ? longRun  + 1 : 0
shortRun := shortOk ? shortRun + 1 : 0

clearOnZero = clearMode == "Pri prechode cez nulu" or clearMode == "Oboje"
clearOnDay  = clearMode == "Na začiatku dňa" or clearMode == "Oboje"

var int state = 0
nextState = state
if longRun >= confirmBars
    nextState := 1
else if shortRun >= confirmBars
    nextState := -1
// Skóre prešlo na druhú stranu nuly, ale opačný signál sa (zatiaľ) nepotvrdil:
// starý smer už neplatí, nový ešte nie. To je BEZ SMERU, nie opačný signál.
else if clearOnZero and not na(score) and ((state == 1 and score < 0) or (state == -1 and score > 0))
    nextState := 0
// Včerajší stav nemá čo hovoriť o dnešku — percentá aj EMA sa ráno resetujú, stav tiež.
if clearOnDay and newDay
    nextState := 0

live    = onClose ? barstate.isconfirmed : true
goLong  = live and nextState ==  1 and state !=  1
goShort = live and nextState == -1 and state != -1
if live
    state := nextState

// ------------------------------------------------------ varovania --- //
// Varovania platia len vtedy, keď má indikátor vôbec názor. Pred otvorením burzy
// stoja všetky tituly presne na svojom ukotvení, percentá sú nuly a z porovnávania
// núl vychádza „nesúhlas", ktorý nič neznamená — predtým sa preto ◆ tiahlo celým
// nočným úsekom.
warnOk   = ready and inRth
//: Pod týmto prahom sa percentá berú ako nula a neporovnávajú sa.
wEps     = normPct * 0.3

// Úzky ťah: kôš letí, index stojí — nesú to mega-capy, zvyšok trhu nejde s nimi.
narrow   = warnOk and not na(cLead) and math.abs(cLead) > 0.8
     and not na(idxPct) and math.abs(idxPct) < wEps
// Semis idú proti košu — historicky to býva skôr varovanie než príležitosť.
// Obe strany musia byť dosť ďaleko od nuly, inak sa porovnáva šum.
soxxAway = warnOk and not na(soxxPct) and not na(basketPct)
     and math.abs(soxxPct) > wEps and math.abs(basketPct) > wEps
     and math.sign(soxxPct) != math.sign(basketPct)
// Priemer hovorí niečo iné než šírka: pár mien ťahá, zvyšok nie.
thin     = warnOk and ((not na(cBasket) and math.abs(cBasket) > 0.5 and math.abs(cBreadth) < 0.3)
     or singleMove)

showScore = viewMode == "Skóre smeru"
strong    = not na(score) and math.abs(score) >= scoreTh
up        = not na(score) and score > 0

mainVal   = showScore ? score : basketPct
thPosAbs  = showScore ? float(scoreTh) : normPct

// Tri úrovne, nie dve: smer HORE/DOLE hovorí znamienko, silu hovorí jas.
// Slabé skóre je ten istý odtieň, len stlmený — tak je na prvý pohľad vidieť
// aj to, kam to ide, aj to, či je to presvedčivé.
baseCol = na(score) ? C_FLAT : up ? C_UP : C_DN
//: Presvedčivosť sa prejaví plynule, nie skokom na prahu — čím ďalej od nuly,
//: tým sýtejšia čiara aj výplň. Prah ostáva len hranicou pre samotný signál.
conv    = math.min(math.abs(nz(mainVal)) / math.max(thPosAbs, 1.0), 1.0)
lineCol = na(score) ? C_FLAT : color.new(baseCol, math.round(55 - 55 * conv))
areaCol = na(score) ? na     : color.new(baseCol, math.round(90 - 35 * conv))
histCol = na(score) ? na     : color.from_gradient(conv, 0.0, 1.0,
     color.new(baseCol, 70), color.new(baseCol, 10))

stavTxt = not inRth ? "MIMO HODÍN" : state == 1 ? "LONG" : state == -1 ? "SELL" : "BEZ SMERU"
stavCol = not inRth ? #37474f : state == 1 ? C_UP : state == -1 ? C_DN : #546e7a

// ------------------------------------------------------------ kresby --- //
// Jedna dvojica plotov slúži obom režimom, aby v legende nezostávali prázdne ∅.
//   skóre:    hlavná = vyhladené skóre, referencia = surové (nevyhladené)
//   percentá: hlavná = kôš, referencia = jeho EMA
thPos   =  thPosAbs
thNeg   = -thPosAbs

hline(0, "Nula", color=color.new(#607d8b, 35), linestyle=hline.style_solid, linewidth=1)

wantArea = shapeMode == "Plocha" or shapeMode == "Oboje"
wantHist = shapeMode == "Histogram" or shapeMode == "Oboje"

// Histogram: stĺpce tmavnú a rozsvecujú sa s presvedčivosťou skóre.
plot(wantHist ? mainVal : na, "Histogram", color=histCol, style=plot.style_columns,
     display=display.pane)

// `display.pane` = kresli, ale nelez do status line. Bez toho tam za každú vypnutú
// čiaru ostane prázdne ∅ a hlavička sa stane nečitateľnou.
plot(wantArea ? mainVal : na, "Plocha", color=areaCol, style=plot.style_area, linewidth=1,
     display=display.pane)

// Žiara: tá istá čiara trikrát pod sebou, vždy širšia a priesvitnejšia. Je to jediný
// spôsob, ako v Pine spraviť neónový efekt — vlastné tiene sa kresliť nedajú.
plot(useGlow ? mainVal : na, "Žiara 3", color=color.new(baseCol, 90), linewidth=10, display=display.pane)
plot(useGlow ? mainVal : na, "Žiara 2", color=color.new(baseCol, 82), linewidth=6,  display=display.pane)
plot(useGlow ? mainVal : na, "Žiara 1", color=color.new(baseCol, 70), linewidth=3,  display=display.pane)
plot(mainVal, "Smer", color=lineCol, linewidth=2)

plot(thPos, "Prah +", color=color.new(C_UP, 55), display=display.pane)
plot(thNeg, "Prah −", color=color.new(C_DN, 55), display=display.pane)

// Pásik stavu pri spodnej hrane — najrýchlejšia odpoveď na otázku „kam teraz".
// Mimo burzových hodín stav nezaniká, ale ani sa nekreslí — je to včerajší názor
// na dnes stojaté dáta a zelený pásik cez celú noc by tvrdil niečo, čo neplatí.
plotshape(inRth and state ==  1 ? 1 : na, "Stav LONG", shape.square, location.bottom,
     color=C_UP, size=size.tiny, display=display.pane)
plotshape(inRth and state == -1 ? 1 : na, "Stav SELL", shape.square, location.bottom,
     color=C_DN, size=size.tiny, display=display.pane)

// Zložky skóre — v mierke skóre (−100…+100), preto len v režime skóre.
plot(showScore and showParts ? cBreadth * 100 : na, "Zložka: šírka",   color=C_BREAD,
     style=plot.style_stepline, display=display.pane)
plot(showScore and showParts ? cSoxx    * 100 : na, "Zložka: SOXX",    color=C_SOXX, display=display.pane)
plot(showScore and showParts ? cLead    * 100 : na, "Zložka: vedenie", color=C_LEAD, display=display.pane)
plot(showScore and showParts ? cTrend   * 100 : na, "Zložka: trend",   color=C_TREND, display=display.pane)

// Do Data Window ide vždy všetko, nech sa dá čítať v oboch režimoch.
// Pre alerty a export; v tabuľke je to isté čitateľnejšie.
plot(score, "» skóre",         color=color.new(C_FLAT, 100), display=display.data_window)
plot(state, "» stav (1/0/−1)", color=color.new(C_FLAT, 100), display=display.data_window)

// Pozadie patrí STAVU, nie varovaniam — je to jediná informácia, ktorú chceš
// vidieť aj periférnym videním. Veľmi jemne, nech neprebije samotnú čiaru.
// Na malom paneli (mobil) je pozadie často to jediné, čo je poriadne vidieť,
// preto je sýtejšie, než by sa na veľkom monitore hodilo.
bgcolor(showState and inRth and state ==  1 ? color.new(C_UP, 88) : na, title="Stav LONG")
bgcolor(showState and inRth and state == -1 ? color.new(C_DN, 88) : na, title="Stav SELL")
bgcolor(not inRth ? color.new(#263238, 82) : na, title="Mimo burzových hodín")

// Varovania sú značky pri hornej hrane, nie plochy cez celý panel — inak
// prekryjú graf presne vtedy, keď na ňom najviac záleží.
plotchar(showWarn and (narrow or thin) ? 1 : na, "Úzky ťah", "▲", location.top,
     color=C_LEAD, size=size.tiny, display=display.pane)
plotchar(showWarn and soxxAway ? 1 : na, "SOXX proti košu", "◆", location.top,
     color=C_SOXX, size=size.tiny, display=display.pane)
plotchar(showWarn and impulse  ? 1 : na, "Impulz (reakcia na správu)", "⚡", location.top,
     color=C_WARN, size=size.tiny, display=display.pane)
plotchar(showWarn and vixSpike ? 1 : na, "Skok VIX", "✦", location.top,
     color=C_WARN2, size=size.tiny, display=display.pane)

// Štítky sedia PRIAMO NA ČIARE v mieste otočenia — na spodnej hrane ich prekrýval
// pásik stavu a v paneli sa strácali.
// Štítok + šípka pod ním, ako to má väčšina moderných indikátorov: štítok nesie text,
// šípka dáva smeru tvar, ktorý sa dá prečítať aj bokom okom.
plotshape(goLong  ? mainVal : na, "Signál LONG", shape.labelup,   location.absolute,
     color=C_UP, text="LONG", textcolor=#0b0f14, size=size.normal, display=display.pane)
plotshape(goShort ? mainVal : na, "Signál SELL", shape.labeldown, location.absolute,
     color=C_DN, text="SELL", textcolor=#0b0f14, size=size.normal, display=display.pane)
plotchar(goLong  ? mainVal : na, "Šípka LONG", "▲", location.absolute, color=C_UP,
     size=size.tiny, display=display.pane)
plotchar(goShort ? mainVal : na, "Šípka SELL", "▼", location.absolute, color=C_DN,
     size=size.tiny, display=display.pane)

// ---- značky priamo na cenovom grafe ---- //
// `force_overlay` dovolí panelovému indikátoru kresliť aj do hlavného grafu. Keby ho
// tvoja verzia TradingView nepoznala, zmaž tieto dva riadky — nič iné na nich nevisí.
plotshape(markOnChart and goLong  ? low  : na, "Na grafe: LONG", shape.labelup, location.absolute,
     color=C_UP, text="LONG", textcolor=#0b0f14, size=size.small,
     display=display.pane, force_overlay=true)
plotshape(markOnChart and goShort ? high : na, "Na grafe: SELL", shape.labeldown, location.absolute,
     color=C_DN, text="SELL", textcolor=#0b0f14, size=size.small,
     display=display.pane, force_overlay=true)

// Veľká visačka na poslednom bare: aktuálny stav sa dá prečítať bez hľadania.
var label tag = na
if barstate.islast
    label.delete(tag)
    tag := label.new(bar_index + 2, nz(mainVal, 0), stavTxt,
         style=label.style_label_left, size=size.large,
         color=color.new(stavCol, state == 0 or not inRth ? 35 : 0),
         textcolor=state == 0 or not inRth ? color.white : #0b0f14)

alertcondition(goLong,  "Big 7: LONG", "Big 7 + SOXX: smer nahor")
alertcondition(goShort, "Big 7: SELL", "Big 7 + SOXX: smer nadol")
alertcondition(narrow or thin, "Big 7: úzky ťah", "Kôš ťahá, ale index alebo šírka nejdú s ním")
alertcondition(impulse, "Big 7: impulz", "Kôš sa pohol náhle — trh na niečo reaguje")
alertcondition(vixSpike, "Big 7: skok VIX", "VIX vyskočil, trh dostal strach")

// ---------------------------------------------------------- tabuľka --- //
// SMER je prvý riadok, nie posledný. V nízkom paneli sa tabuľka odreže zdola —
// a odrezať to jediné číslo, kvôli ktorému sa na ňu pozeráš, je nezmysel.
f_pctTxt(v) => na(v) ? "—" : str.tostring(v, "+0.00;-0.00") + " %"
f_pctCol(v) => na(v) ? C_FLAT : v > 0 ? C_UP : C_DN

f_row(t, row, name, pct) =>
    table.cell(t, 0, row, str.replace_all(str.replace_all(name, "NASDAQ:", ""), "BATS:", ""),
         text_color=C_FLAT, text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, row, f_pctTxt(pct), text_color=f_pctCol(pct), text_size=size.small)

tPos = tablePos == "Vpravo hore" ? position.top_right
     : tablePos == "Vpravo dole" ? position.bottom_right
     : tablePos == "Vľavo hore"  ? position.top_left : position.bottom_left

//: Riadky sa číslujú počítadlom, nie napevno — inak by sa pri vypnutom bloku správ
//: alebo pri kratšej tabuľke museli indexy prepočítavať ručne pri každej zmene.
f_head(t, row, name, val, col) =>
    table.cell(t, 0, row, name, text_color=color.white, text_size=size.small,
         text_halign=text.align_left, bgcolor=color.new(#263238, 30))
    table.cell(t, 1, row, val, text_color=col, text_size=size.normal,
         bgcolor=color.new(#263238, 30))

if showTable and barstate.islast
    var table t = table.new(tPos, 2, 16, border_width=1,
         frame_color=color.new(#455a64, 40), frame_width=1)
    table.clear(t, 0, 0, 1, 15)
    r = 0

    // ---- to podstatné, hore a veľkým ---- //
    table.cell(t, 0, r, "SMER", text_color=#0b0f14, text_size=size.normal,
         text_halign=text.align_left, bgcolor=stavCol)
    table.cell(t, 1, r, stavTxt, text_color=#0b0f14, text_size=size.normal,
         text_halign=text.align_center, bgcolor=stavCol)
    r += 1

    if tableSize != "Len smer"
        f_head(t, r, "skóre", na(score) ? "—" : str.tostring(score, "+0;-0"), lineCol)
        r += 1
        f_head(t, r, "šírka", str.tostring(nUp) + " / " + str.tostring(nOk),
             nUp >= minBreadth ? C_UP : nDown >= minBreadth ? C_DN : C_FLAT)
        r += 1
        if useNews
            f_head(t, r, "správy", newsTxt, newsCol)
            r += 1

    // ---- kontext ---- //
    if tableSize == "Stredná" or tableSize == "Plná"
        table.cell(t, 0, r, "KÔŠ", text_color=color.white, text_size=size.small,
             text_halign=text.align_left)
        table.cell(t, 1, r, f_pctTxt(basketPct), text_color=f_pctCol(basketPct), text_size=size.small)
        r += 1
        f_row(t, r, soxxSym, soxxPct)
        r += 1
        f_row(t, r, idxSym, idxPct)
        r += 1
        if useNews
            f_row(t, r, vixSym, vixPct)
            r += 1
            table.cell(t, 0, r, "rozptyl", text_color=C_FLAT, text_size=size.small,
                 text_halign=text.align_left)
            table.cell(t, 1, r, na(dispRel) ? "—" : str.tostring(dispRel, "0.00"),
                 text_color=singleMove ? C_WARN : macroMove ? C_UP : C_FLAT, text_size=size.small)
            r += 1

    // ---- jednotlivé tituly, voliteľne ---- //
    if tableSize == "Plná"
        f_row(t, r, s1, p1)
        r += 1
        f_row(t, r, s2, p2)
        r += 1
        f_row(t, r, s3, p3)
        r += 1
        f_row(t, r, s4, p4)
        r += 1
        f_row(t, r, s5, p5)
        r += 1
        f_row(t, r, s6, p6)
        r += 1
        f_row(t, r, s7, p7)
