//@version=5
// Big 7 — vážený kôš siedmich najväčších technologických titulov na Nasdaqu
// s vlastnou EMA a explicitnými signálmi LONG / SELL.
//
// Oproti bežnej verzii tohto nápadu rieši päť vecí, kvôli ktorým inak vychádzajú
// nepresné čísla a falošné signály:
//
//   1. Chýbajúci titul sa VYNECHÁ z priemeru, nepočíta sa ako 0 %. Keď jeden feed
//      mlčí, bežná verzia pripočíta nulu a aj tak delí siedmimi — kôš to ťahá k nule.
//   2. EMA sa na začiatku dňa RESETUJE. Percentá sú ukotvené k dennému otvoreniu
//      (alebo k včerajšiemu zavretiu), takže séria každé ráno skočí späť k nule;
//      priebežná EMA by do dnešného otvorenia ťahala včerajšie hodnoty.
//   3. Pridáva ŠÍRKU trhu: koľko zo siedmich je nad vlastným ukotvením. Priemer
//      +0,8 % môže znamenať NVDA +6 % a šesť titulov v mínuse — to nie je long.
//   4. Signál sa mení až na ZAVRETÍ sviečky a musí vydržať N sviečok, takže
//      neprekresľuje a nepreblikáva na hranici.
//   5. Prvých N sviečok dňa je hluchých — čerstvo resetovaná EMA sa ešte rovná
//      samotnému košu a sklon z nej nič nehovorí.
//
// Ukotvenie „Včerajšie zavretie" je to, čo ako dennú zmenu ukazujú burzové weby.
// „Denné otvorenie" meria len pohyb v rámci seansy, bez nočnej medzery.

indicator("Big 7 Basket EMA + signály", overlay=false, precision=2)

// ---------------------------------------------------------------- kôš --- //
_GK = "Kôš"
s1 = input.symbol("NASDAQ:NVDA",  "1", group=_GK, inline="a1")
w1 = input.float(1.0, "váha",     group=_GK, inline="a1", minval=0.0, step=0.1)
s2 = input.symbol("NASDAQ:MSFT",  "2", group=_GK, inline="a2")
w2 = input.float(1.0, "váha",     group=_GK, inline="a2", minval=0.0, step=0.1)
s3 = input.symbol("NASDAQ:AAPL",  "3", group=_GK, inline="a3")
w3 = input.float(1.0, "váha",     group=_GK, inline="a3", minval=0.0, step=0.1)
s4 = input.symbol("NASDAQ:AMZN",  "4", group=_GK, inline="a4")
w4 = input.float(1.0, "váha",     group=_GK, inline="a4", minval=0.0, step=0.1)
s5 = input.symbol("NASDAQ:GOOGL", "5", group=_GK, inline="a5")
w5 = input.float(1.0, "váha",     group=_GK, inline="a5", minval=0.0, step=0.1)
s6 = input.symbol("NASDAQ:META",  "6", group=_GK, inline="a6")
w6 = input.float(1.0, "váha",     group=_GK, inline="a6", minval=0.0, step=0.1)
s7 = input.symbol("NASDAQ:TSLA",  "7", group=_GK, inline="a7")
w7 = input.float(1.0, "váha",     group=_GK, inline="a7", minval=0.0, step=0.1)
weightMode = input.string("Rovnaká váha", "Váženie", options=["Rovnaká váha", "Vlastné váhy"],
     group=_GK, tooltip="Vlastné váhy = do políčok napíš trhové kapitalizácie alebo váhy " +
     "z indexu. Normalizujú sa samy, takže nemusia dávať súčet 1.")

// ----------------------------------------------------------- výpočet --- //
_GV = "Výpočet"
anchorMode = input.string("Včerajšie zavretie", "Percentá počítať od",
     options=["Včerajšie zavretie", "Denné otvorenie"], group=_GV,
     tooltip="Včerajšie zavretie = denná zmena, akú ukazujú burzové weby (obsahuje nočnú " +
     "medzeru). Denné otvorenie = len pohyb v rámci dnešnej seansy.")
emaLen     = input.int(9, "Dĺžka EMA koša", minval=2, maxval=200, group=_GV)
resetDaily = input.bool(true, "Resetovať EMA na začiatku dňa", group=_GV,
     tooltip="Zapnuté (odporúčané): EMA začína každý deň odznova. Vypnuté: EMA beží cez " +
     "noc ďalej a prvé hodiny dňa ťahá včerajšími hodnotami.")

// ------------------------------------------------------------ signál --- //
_GS = "Signál"
minBreadth  = input.int(5, "Min. titulov na strane signálu", minval=1, maxval=7, group=_GS,
     tooltip="Koľko zo siedmich musí byť na správnej strane vlastného ukotvenia. 5 z 7 " +
     "znamená, že signál nesmie stáť na jednom ťahúňovi.")
minBasket   = input.float(0.15, "Min. |kôš| (%)", minval=0.0, step=0.05, group=_GS)
minSlope    = input.float(0.015, "Min. |sklon EMA| za sviečku", minval=0.0, step=0.005, group=_GS)
confirmBars = input.int(2, "Potvrdiť N sviečok", minval=1, maxval=20, group=_GS)
skipOpen    = input.int(3, "Preskočiť prvých N sviečok dňa", minval=0, maxval=60, group=_GS,
     tooltip="Čerstvo resetovaná EMA sa rovná samotnému košu, takže sklon z nej prvé " +
     "sviečky nič nehovorí.")
onClose     = input.bool(true, "Signál až na zavretí sviečky", group=_GS,
     tooltip="Zapnuté: indikátor neprekresľuje. Vypnuté: signál skočí už počas sviečky " +
     "a môže zmiznúť, kým sviečka zavrie.")

// ---------------------------------------------------------- zobraz. --- //
_GZ = "Zobrazenie"
showBreadth = input.bool(true,  "Kresliť šírku trhu", group=_GZ)
showFlat    = input.bool(true,  "Podfarbiť pásmo bez smeru", group=_GZ)
showTable   = input.bool(true,  "Tabuľka titulov", group=_GZ)

// ------------------------------------------------------------------ //
// Percentuálna zmena jedného titulu. Obe ukotvenia si vypýtame naraz jedným
// volaním — `request.security` sa nesmie volať podmienene a tuple ich vráti
// na jeden dotaz namiesto dvoch.
// ------------------------------------------------------------------ //
f_pct(sym) =>
    [dOpen, dPrevClose] = request.security(sym, "D", [open, close[1]],
         barmerge.gaps_off, barmerge.lookahead_off)
    px = request.security(sym, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
    anchor = anchorMode == "Denné otvorenie" ? dOpen : dPrevClose
    na(px) or na(anchor) or anchor == 0 ? float(na) : (px - anchor) / anchor * 100.0

p1 = f_pct(s1)
p2 = f_pct(s2)
p3 = f_pct(s3)
p4 = f_pct(s4)
p5 = f_pct(s5)
p6 = f_pct(s6)
p7 = f_pct(s7)

pcts = array.from(p1, p2, p3, p4, p5, p6, p7)
wts  = array.from(w1, w2, w3, w4, w5, w6, w7)

// Vážený priemer len z titulov, ktoré naozaj majú dáta — chýbajúci sa nevynuluje,
// ale vypadne aj z menovateľa.
pSum  = 0.0
wSum  = 0.0
nOk   = 0
nUp   = 0
for i = 0 to 6
    p = array.get(pcts, i)
    w = weightMode == "Rovnaká váha" ? 1.0 : array.get(wts, i)
    if not na(p) and w > 0
        pSum += p * w
        wSum += w
        nOk  += 1
        if p > 0
            nUp += 1
nDown     = nOk - nUp
basketPct = wSum > 0 ? pSum / wSum : float(na)

// --------------------------------------------------- EMA s resetom --- //
newDay = ta.change(time("D")) != 0
var int barsToday = 0
barsToday := newDay ? 1 : barsToday + 1

alpha = 2.0 / (emaLen + 1)
var float basketEma = na
if not na(basketPct)
    basketEma := na(basketEma) or (resetDaily and newDay)
         ? basketPct
         : basketEma + alpha * (basketPct - basketEma)

// Na resetovej sviečke nie je sklon definovaný — inak by z neho vyšiel skok
// z včerajšej hodnoty na dnešnú nulu.
emaSlope = (resetDaily and newDay) or na(basketEma) or na(basketEma[1])
     ? 0.0 : basketEma - basketEma[1]

// ------------------------------------------------------- stav LONG/SELL --- //
ready   = not na(basketPct) and not na(basketEma) and barsToday > skipOpen and nOk > 0
longOk  = ready and basketPct > basketEma and basketPct >  minBasket and emaSlope >  minSlope and nUp   >= minBreadth
shortOk = ready and basketPct < basketEma and basketPct < -minBasket and emaSlope < -minSlope and nDown >= minBreadth

var int longRun  = 0
var int shortRun = 0
longRun  := longOk  ? longRun  + 1 : 0
shortRun := shortOk ? shortRun + 1 : 0

var int state = 0
next = state
if longRun >= confirmBars
    next := 1
else if shortRun >= confirmBars
    next := -1

live    = onClose ? barstate.isconfirmed : true
goLong  = live and next ==  1 and state !=  1
goShort = live and next == -1 and state != -1
if live
    state := next

// ------------------------------------------------------------ kresby --- //
hline(0, "Nula", color=color.new(color.gray, 40), linestyle=hline.style_dotted)

cBasket = na(basketEma) ? color.new(color.gray, 60)
     : basketPct >= basketEma ? color.new(#26a69a, 55) : color.new(#ef5350, 55)
cEma = emaSlope > 0 ? #26a69a : emaSlope < 0 ? #ef5350 : color.gray

plot(basketPct, "Kôš Big 7 (%)", color=cBasket, style=plot.style_columns)
plot(basketEma, "EMA koša", color=cEma, linewidth=2)
plot(showBreadth ? nUp - nDown : na, "Šírka (hore − dole)", color=color.new(color.blue, 30),
     style=plot.style_stepline, display=display.data_window + display.pane)

isFlat = ready and math.abs(emaSlope) < minSlope and math.abs(basketPct) < minBasket
bgcolor(showFlat and isFlat ? color.new(color.yellow, 92) : na, title="Bez smeru")

plotshape(goLong,  "LONG", shape.labelup,   location.bottom, color=#26a69a,
     text="LONG", textcolor=color.white, size=size.small)
plotshape(goShort, "SELL", shape.labeldown, location.top,    color=#ef5350,
     text="SELL", textcolor=color.white, size=size.small)

alertcondition(goLong,  "Big 7: LONG", "Big 7 kôš otočil nahor")
alertcondition(goShort, "Big 7: SELL", "Big 7 kôš otočil nadol")

// ---------------------------------------------------------- tabuľka --- //
f_row(t, row, sym, pct) =>
    table.cell(t, 0, row, str.replace_all(sym, "NASDAQ:", ""), text_color=color.gray,
         text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, row, na(pct) ? "—" : str.tostring(pct, "+0.00;-0.00") + " %",
         text_color=na(pct) ? color.gray : pct > 0 ? #26a69a : #ef5350, text_size=size.small)

if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 10, border_width=1)
    f_row(t, 0, s1, p1)
    f_row(t, 1, s2, p2)
    f_row(t, 2, s3, p3)
    f_row(t, 3, s4, p4)
    f_row(t, 4, s5, p5)
    f_row(t, 5, s6, p6)
    f_row(t, 6, s7, p7)
    table.cell(t, 0, 7, "kôš", text_color=color.white, text_size=size.small,
         text_halign=text.align_left)
    table.cell(t, 1, 7, na(basketPct) ? "—" : str.tostring(basketPct, "+0.00;-0.00") + " %",
         text_color=color.white, text_size=size.small)
    table.cell(t, 0, 8, "šírka", text_color=color.gray, text_size=size.small,
         text_halign=text.align_left)
    table.cell(t, 1, 8, str.tostring(nUp) + " / " + str.tostring(nOk),
         text_color=color.gray, text_size=size.small)
    table.cell(t, 0, 9, "stav", text_color=color.gray, text_size=size.small,
         text_halign=text.align_left)
    table.cell(t, 1, 9, state == 1 ? "LONG" : state == -1 ? "SELL" : "—",
         text_color=state == 1 ? #26a69a : state == -1 ? #ef5350 : color.gray,
         text_size=size.small)
